<Project Sdk="Microsoft.NET.Sdk">

    <!-- Le noyau : le modèle de document et les services qui l'écrivent, le relisent
         et l'exportent. Aucune référence à Avalonia — c'est ce qui permet de le
         charger dans un hôte de test sans plate-forme graphique, et c'est la règle
         qu'énonce déjà le commentaire en tête de Models/Frame.cs. Le découpage ne
         déplace aucune ligne de code : il matérialise une séparation que le code
         respectait déjà. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>MyPublisher</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- ObservableObject, porté par Document et Frame. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1"/>
        <!-- L'export PDF est un service du noyau : l'écran et le PDF partagent le
             même modèle, sans couche intermédiaire susceptible de diverger. -->
        <PackageReference Include="PdfSharp" Version="6.2.1"/>
        <!-- La vérification orthographique (N25) : un portage de Hunspell en code géré,
             sans bibliothèque native. Licence héritée de Hunspell, au choix MPL 1.1,
             GPL 2.0 ou LGPL 2.1 ; MyPublisher la prend sous MPL 1.1, sans modifier le
             code : l'obligation est une mention, au README. Les dictionnaires sont ceux
             du système (/usr/share/hunspell). -->
        <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1"/>
    </ItemGroup>

</Project>
