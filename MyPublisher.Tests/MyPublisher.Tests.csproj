<Project Sdk="Microsoft.NET.Sdk">

    <!-- Les tests du noyau : modèle, géométrie, sérialisation, migrations, champs.
         Ce projet ne référence QUE MyPublisher.Core — pas l'application. C'est
         volontaire : ces tests doivent tourner sans plate-forme graphique, en une
         poignée de secondes, et rester la première chose qui échoue quand un poste
         casse le modèle. Ce qui demande une fenêtre est dans
         MyPublisher.Tests.Interface. -->

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyPublisher.Core\MyPublisher.Core.csproj"/>
    </ItemGroup>

</Project>
