        {
          "$kind": "shape",
          "Name": "Filet de titre",
          "X": 56.69,
          "Y": 104,
          "Width": 90,
          "Height": 2.5,
          "Rotation": 0,
          "Fill": {
            "$kind": "solid",
            "Color": "#FF1F3B57"
          },
          "Stroke": null,
          "StrokeThickness": 0,
          "StrokeStyle": "Solid",
          "CornerRadius": 0,
