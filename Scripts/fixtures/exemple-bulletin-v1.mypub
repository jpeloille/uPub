          "Rotation": 0,
          "Text": "Le Petit Composeur",
          "FontFamily": "DejaVu Sans",
          "FontSize": 30,
          "Bold": true,
          "Italic": false,
          "Foreground": "#FFFFFFFF",
          "Background": null,
          "Align": "Left",
