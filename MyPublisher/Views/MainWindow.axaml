<!--
    La fenêtre principale, disposée comme la maquette « Fenêtre principale — bloc de texte
    sélectionné » (phase I, poste I2, avec B7). De haut en bas : la barre de menus, la barre
    principale à icônes, la place de la barre contextuelle, l'espace de travail — rail
    d'outils, panneau Pages, planche, dock à quatre onglets —, et la barre d'état.

    Les couleurs, les tailles et les icônes viennent de l'apparence (Apparence.axaml, poste
    I1), citée par ses clés : cette vue est de la phase, et n'écrit aucune couleur de la
    maquette en dur — la recette I1 le vérifie. Les styles propres à la fenêtre — menus,
    onglets, lignes des listes, bouton principal — sont ici, au-dessous, et ne citent qu'elle.

    Quatre points d'accroche, pour les postes qui suivent sans toucher à ce fichier :
    - la barre contextuelle est un contrôle à part (BarreContextuelle.axaml), que I3 a rempli
      de la mise en forme du texte, qui a quitté le dock ;
    - une entrée du panneau Pages aussi (EntreeDePage.axaml), que I5 change en vignette ;
    - « Page entière » et « Conserver les proportions » sont posés, liés au modèle de vue,
      dont I6 écoute la demande et lit la case — la planche tient la page, et les champs L
      et H passent par le modèle de vue pour garder le rapport du bloc ;
    - la place de l'œil dans « Blocs de la page », où I8 a posé l'œil, et celle de l'alerte
      d'excédent dans « Cadre de texte » (I9) sont réservées, chacune sous son nom.
    Les boutons Main et Zoom du rail sont venus avec leur geste (I6) ; Ligne (A10) n'y est
    pas encore : un bouton n'apparaît qu'avec son geste. Sa place est dite dans le rail.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyPublisher.ViewModels"
        xmlns:models="using:MyPublisher.Models"
        xmlns:views="using:MyPublisher.Views"
        xmlns:conv="using:MyPublisher.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MyPublisher.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1440" Height="900"
        Background="{StaticResource FondFenetre}"
        Foreground="{StaticResource Texte}"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+G" Command="{Binding GroupSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+H" Command="{Binding UngroupSelectedCommand}"/>
        <!-- Ordre de superposition. Publisher ne donne de raccourci qu'aux deux
             extrêmes (fiche 15) : avancer et reculer d'un rang n'en ont pas, et on
             ne leur en invente pas. Publisher 2007 les posait sur Alt+F6 et
             Alt+Maj+F6 ; ce sont les combinaisons modernes qui sont reprises ici,
             Alt+F6 étant capté par la plupart des gestionnaires de fenêtres Linux —
             un raccourci qui ne peut pas arriver jusqu'à l'application ne sert à rien. -->
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding BringToFrontCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding SendToBackCommand}"/>
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}"/>
        <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ZoomResetCommand}"/>
        <!-- Le gras et l'italique comme dans Publisher en français : G et I. Ni l'un ni
             l'autre n'est pris par OnKeyDown, qui n'intercepte sous Ctrl que N, O, S et E. -->
        <KeyBinding Gesture="Ctrl+G" Command="{Binding BasculerGrasCommand}"/>
        <KeyBinding Gesture="Ctrl+I" Command="{Binding BasculerItaliqueCommand}"/>
        <!-- Le souligné, Ctrl+U comme dans Publisher (poste I3, sur la commande de I7) : U
             n'est pris ni par OnKeyDown ni par un autre geste. -->
        <KeyBinding Gesture="Ctrl+U" Command="{Binding SoulignerCommand}"/>
        <!-- B7 : replier les panneaux, comme le Ctrl+F1 de Publisher (fiche 04). Ni GNOME
             ni KDE ne le prennent par défaut, à la différence d'Alt+F6 (poste A4). -->
        <KeyBinding Gesture="Ctrl+F1" Command="{Binding ReplierLesPanneauxCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>

        <!-- La barre de menus : les « .menu » de la maquette, corps 12,5, rayon 4, survol
             gris. Les menus déroulants gardent Fluent ; seule la barre est rhabillée. Fluent
             donne au menu 32 px de haut, où chaque entrée s'étire : le survol en ferait 32
             au lieu des 23 de la maquette (4 + la ligne + 4), centrés dans la barre de 34. -->
        <Style Selector="Menu.barreDeMenus">
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Menu.barreDeMenus > MenuItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="NaN"/>
        </Style>
        <Style Selector="Menu.barreDeMenus > MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Menu.barreDeMenus > MenuItem:pointerover /template/ Border#PART_LayoutRoot,
                         Menu.barreDeMenus > MenuItem:selected /template/ Border#PART_LayoutRoot,
                         Menu.barreDeMenus > MenuItem:open /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource Survol}"/>
        </Style>
        <Style Selector="Menu.barreDeMenus > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter,
                         Menu.barreDeMenus > MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter,
                         Menu.barreDeMenus > MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
        </Style>

        <!-- Le bouton Italique, comme la maquette : un « I » penché en Georgia, à défaut une
             serif qui a une vraie face italique — la serif générique de fontconfig peut être
             une sans, d'où les deux noms avant elle. Inter, la police du chrome, n'a pas de
             face italique : penché par simulation, son « I » sans empattement se lit comme
             une barre oblique. -->
        <Style Selector="ToggleButton.ib.italique">
            <Setter Property="FontFamily" Value="Georgia, Noto Serif, Liberation Serif, serif"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Un bouton à libellé de la barre principale — « Page entière » : le « .menu » de
             la maquette, bordé comme un champ, de la hauteur d'un champ. -->
        <Style Selector="Button.commandeTexte">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordChamp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.commandeTexte:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.commandeTexte:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Survol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordChamp}"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
        </Style>
        <Style Selector="Button.commandeTexte:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordChamp}"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
        </Style>
        <Style Selector="Button.commandeTexte:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Le bouton principal, « Exporter en PDF » : plein d'accent, rayon 6, demi-gras ;
             le survol prend l'accent sombre de la maquette. -->
        <Style Selector="Button.principal">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Blanc}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.principal:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.principal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSurvol}"/>
            <Setter Property="Foreground" Value="{StaticResource Blanc}"/>
        </Style>

        <!-- Les filets du rail, entre ses groupes d'outils : 24 × 1, du gris des panneaux. -->
        <Style Selector="Border.filetDuRail">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Filet}"/>
        </Style>

        <!-- Le dock : quatre onglets, l'onglet choisi souligné d'accent et en demi-gras. Les
             modèles sont écrits ici plutôt que repris de Fluent, qui donne aux onglets un
             corps de 24 et 48 px de haut. -->
        <Style Selector="TabControl.dock">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Filet}"
                                BorderThickness="0,0,0,1" Padding="8,6,8,0">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Sans la marge que Fluent pose sous les onglets : le trait d'accent de l'onglet
             choisi touche le filet, comme la maquette. Un style, et non une valeur dans le
             modèle, qu'un style de Fluent l'emporterait. -->
        <Style Selector="TabControl.dock /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="TabControl.dock TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Libelle}"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Pas « PART_LayoutRoot » : Fluent peindrait son fond de survol sur un
                         élément de ce nom. -->
                    <Border Name="Onglet" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.dock TabItem:selected">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
        </Style>
        <Style Selector="TabControl.dock TabItem:selected /template/ Border#Onglet">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <!-- Une section du dock : le chevron suit la section, ouvert vers le bas. -->
        <Style Selector="ToggleButton.titreSection ContentControl.chevronOuvert">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ToggleButton.titreSection:checked ContentControl.chevronOuvert">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ToggleButton.titreSection:checked ContentControl.chevronFerme">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- La première section d'un onglet n'a pas de filet au-dessus : l'onglet en a un. -->
        <Style Selector="ToggleButton.premiere">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.premiere:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.premiere:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.premiere:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Le contenu d'une section : les marges de la maquette, 12 sur les côtés et dessous. -->
        <Style Selector=":is(Panel).contenuDeSection">
            <Setter Property="Margin" Value="12,0,12,12"/>
        </Style>
        <!-- Un champ du dock prend sa colonne entière ; un libellé posé au-dessus de lui
             s'en écarte de 3, comme la maquette. -->
        <Style Selector="NumericUpDown.champ, ComboBox.champ">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.libelleAuDessus">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style Selector="TextBlock.libelleAGauche">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Une aide sous un réglage : le gris des libellés, au corps des libellés. -->
        <Style Selector="TextBlock.aide">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Libelle}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Les cases à cocher du dock : la case au corps des libellés, cochée d'accent. -->
        <Style Selector="CheckBox.case">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Libelle}"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox.case /template/ Border#NormalRectangle">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="CheckBox.case /template/ Viewbox">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="CheckBox.case:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="CheckBox.case:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         CheckBox.case:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Libelle}"/>
        </Style>

        <!-- Un bouton à libellé du dock — importer, choisir une image, poser un repère. -->
        <Style Selector="Button.boutonDuDock">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
            <Setter Property="Background" Value="{StaticResource Blanc}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordChamp}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.boutonDuDock:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.boutonDuDock:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Survol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordChamp}"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
        </Style>

        <!-- « Blocs de la page » : des lignes de 26 px à rayon 5 ; la ligne choisie prend
             la pastille et l'accent sombre, comme la maquette. -->
        <Style Selector="ListBox.blocs, ListBox.pages">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.blocs ListBoxItem">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.blocs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="ListBox.blocs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Survol}"/>
            <Setter Property="Foreground" Value="{StaticResource Commande}"/>
        </Style>
        <Style Selector="ListBox.blocs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.blocs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.blocs ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Pastille}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentSurvol}"/>
        </Style>
        <Style Selector="ListBox.blocs ListBoxItem:selected">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <!-- L'œil d'une ligne (poste I8) : l'icône seule, 14 px, sans fond ni bord, au survol
             comme à la pression — c'est la ligne qui se colore sous le pointeur. Il ne prend
             pas le focus : la frappe en cours garde le sien. -->
        <Style Selector="Button.oeil">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.oeil:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.oeil:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Le panneau Pages ne peint rien sur ses conteneurs : l'entrée dit elle-même la
             page courante (EntreeDePage.axaml), et I5 en fera une vignette bordée d'accent
             sans toucher à ces lignes. -->
        <Style Selector="ListBox.pages ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.pages ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pages ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pages ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- La barre d'état : corps 11,5, au gris de la maquette. -->
        <Style Selector="Border#BarreDEtat TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Etat}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Le curseur du zoom : un rail de 4 px, la part parcourue d'accent, un disque blanc
             bordé d'accent pour poignée. Le modèle est écrit ici : celui de Fluent pose sa
             piste 15 px sous le haut du contrôle, pour des graduations qu'on n'a pas. -->
        <Style Selector="Slider.zoom">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Name="PART_Track" Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <Border Height="4" CornerRadius="2,0,0,2" VerticalAlignment="Center"
                                                    Background="{StaticResource Accent}"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <Border Height="4" CornerRadius="0,2,2,0" VerticalAlignment="Center"
                                                    Background="{StaticResource FiletFort}"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                        <Thumb Name="PoigneeDuZoom" Width="12" Height="12">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="{StaticResource Blanc}" BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1.5" CornerRadius="6"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- La vignette de couleur en tête des lignes Fond et Contour : 22 × 22, bordée comme
             un champ, rayon 4. Sans fond ni contour, la diagonale rouge de « Aucun », comme
             la maquette la peint : un dégradé à 135° dont la bande va de 46 à 54 %. -->
        <Style Selector="Border.vignette">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordChamp}"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="Border.vignette.aucune">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0.45" Color="{StaticResource CouleurBlanc}"/>
                    <GradientStop Offset="0.46" Color="{StaticResource CouleurAucun}"/>
                    <GradientStop Offset="0.54" Color="{StaticResource CouleurAucun}"/>
                    <GradientStop Offset="0.55" Color="{StaticResource CouleurBlanc}"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- Les champs de chaque sorte de remplissage, déclarés une fois pour toutes. Le fond
         d'un bloc et le fond de page les partagent : deux copies auraient dérivé, et
         c'est le genre d'écart qui ne se voit qu'en ouvrant les deux panneaux côte à
         côte. L'aplat, lui, se règle par la couleur du porteur — le sélecteur ne peut
         pas être branché sur le remplissage lui-même, il renvoie ce qu'il lit dès qu'il
         s'affiche. -->
    <Window.DataTemplates>

        <!-- L'aplat n'a rien à montrer ici : sa couleur et son opacité se règlent sur le
             porteur, juste au-dessus. Le gabarit existe pour que le sélecteur de sorte
             ne laisse pas voir un nom de classe. -->
        <DataTemplate DataType="models:SolidFill">
            <Panel/>
        </DataTemplate>

        <DataTemplate DataType="models:GradientFill">
            <StackPanel Spacing="3" Margin="0,6,0,0">
                <TextBlock Classes="libelle" Text="Première couleur"/>
                <views:SelecteurDeCouleur Valeur="{Binding From}"
                       Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                <TextBlock Classes="libelle" Text="Seconde couleur" Margin="0,5,0,0"/>
                <views:SelecteurDeCouleur Valeur="{Binding To}"
                       Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                <TextBlock Classes="libelle" Text="Angle" Margin="0,5,0,0"/>
                <!-- Zéro va de gauche à droite, 90 de haut en bas : l'axe Y descend,
                     comme en PDF. Les quatre ombrages de Publisher — horizontal,
                     vertical, deux diagonales — sont 0, 90, 45 et 315. -->
                <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Degres}"
                               Increment="15" Minimum="0" Maximum="360"
                               Value="{Binding Angle, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="models:ImageFill">
            <StackPanel Spacing="3" Margin="0,6,0,0">
                <TextBlock Classes="aide" Text="{Binding Path}"/>
                <Button Classes="boutonDuDock" Content="Choisir une image…" HorizontalAlignment="Left"
                        Click="OnChooseFillImage"/>
                <TextBlock Classes="libelle" Text="Cadrage" Margin="0,5,0,0"/>
                <ComboBox Classes="champ"
                          ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).ImageFits}"
                          SelectedItem="{Binding Fit}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static conv:Libelle.Instance}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="libelle" Text="Rotation" Margin="0,5,0,0"/>
                <!-- Le quart de tour que Publisher pose sur une image de remplissage :
                     une des cinq d'ATA 21 le porte, et sans lui elle arrive couchée. -->
                <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Degres}"
                               Increment="90" Minimum="0" Maximum="270"
                               Value="{Binding Rotation, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="models:TintFill">
            <StackPanel Spacing="3" Margin="0,6,0,0">
                <TextBlock Classes="libelle" Text="Couleur de base"/>
                <views:SelecteurDeCouleur Valeur="{Binding Color}"
                       Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                <TextBlock Classes="libelle" Text="Teinte" Margin="0,5,0,0"/>
                <!-- Cent, c'est la couleur de base ; en dessous on va vers le blanc,
                     au-dessus vers le noir. -->
                <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Pourcent}"
                               Increment="10" Minimum="0" Maximum="200"
                               Value="{Binding Percent, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
            </StackPanel>
        </DataTemplate>

    </Window.DataTemplates>

    <DockPanel>

        <!-- ============================================================ barre de menus -->
        <!-- 34 px et un filet dessous : la marque, les huit menus, le titre du document
             centré dans ce qui reste. La barre de titre du système reste au-dessus, avec son
             « • nom — MyPublisher » : Avalonia étend mal la zone cliente sous Linux, et la
             réserve de 300 px que la maquette laisse à droite pour les boutons de la
             fenêtre n'a pas d'objet sans cette extension. -->
        <Border DockPanel.Dock="Top" x:Name="BarreDeMenus" Height="35"
                Background="{StaticResource Blanc}" BorderBrush="{StaticResource Filet}"
                BorderThickness="0,0,0,1" Padding="10,0">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border x:Name="Marque" Width="18" Height="18" CornerRadius="4" Background="{StaticResource Accent}">
                        <TextBlock Text="M" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blanc}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyPublisher" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Menu Grid.Column="1" x:Name="Menus" Classes="barreDeMenus" VerticalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>

                    <MenuItem Header="_Fichier">
                        <MenuItem Header="_Nouveau…" InputGesture="Ctrl+N" Click="OnNew"/>
                        <Separator/>
                        <MenuItem Header="_Ouvrir…" InputGesture="Ctrl+O" Click="OnOpen"/>
                        <MenuItem Header="_Enregistrer" InputGesture="Ctrl+S" Click="OnSave"/>
                        <MenuItem Header="Enregistrer _sous…" Click="OnSaveAs"/>
                        <Separator/>
                        <MenuItem Header="Exporter en _PDF…" InputGesture="Ctrl+E" Click="OnExportPdf"/>
                        <Separator/>
                        <MenuItem Header="_Quitter" Click="OnQuit"/>
                    </MenuItem>

                    <MenuItem Header="_Édition">
                        <MenuItem Header="_Annuler" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
                        <MenuItem Header="_Rétablir" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Dupliquer" InputGesture="Ctrl+D" Command="{Binding DuplicateSelectedCommand}"/>
                        <MenuItem Header="_Supprimer" InputGesture="Delete" Command="{Binding DeleteSelectedCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Tout sélectionner" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Informations professionnelles…" Click="OnEditBusinessInfo"/>
                    </MenuItem>

                    <MenuItem Header="_Insertion">
                        <MenuItem Header="_Titre" Command="{Binding AddHeadingCommand}"/>
                        <MenuItem Header="Bloc de _texte" Command="{Binding AddTextCommand}"/>
                        <MenuItem Header="_Image…" Click="OnInsertImage"/>
                        <MenuItem Header="Ta_bleau" Command="{Binding AddTableCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Rectangle" Command="{Binding AddRectangleCommand}"/>
                        <MenuItem Header="_Ellipse" Command="{Binding AddEllipseCommand}"/>
                        <MenuItem Header="Tr_ait" Command="{Binding AddLineCommand}"/>
                    </MenuItem>

                    <MenuItem Header="_Disposition">
                        <MenuItem Header="_Grouper" InputGesture="Ctrl+Shift+G"
                                  Command="{Binding GroupSelectedCommand}"/>
                        <MenuItem Header="_Dissocier" InputGesture="Ctrl+Shift+H"
                                  Command="{Binding UngroupSelectedCommand}"/>
                        <Separator/>
                        <MenuItem Header="Premier _plan" InputGesture="Ctrl+Shift+F"
                                  Command="{Binding BringToFrontCommand}"/>
                        <MenuItem Header="_Avancer" Command="{Binding BringForwardCommand}"/>
                        <MenuItem Header="_Reculer" Command="{Binding SendBackwardCommand}"/>
                        <MenuItem Header="Arrière-p_lan" InputGesture="Ctrl+Shift+B"
                                  Command="{Binding SendToBackCommand}"/>
                        <Separator/>
                        <MenuItem Header="Aligner à _gauche" Command="{Binding AlignLeftCommand}"/>
                        <MenuItem Header="Centrer _horizontalement" Command="{Binding AlignCentreHorizontallyCommand}"/>
                        <MenuItem Header="Aligner à _droite" Command="{Binding AlignRightCommand}"/>
                        <MenuItem Header="Aligner en _haut" Command="{Binding AlignTopCommand}"/>
                        <MenuItem Header="Centrer _verticalement" Command="{Binding AlignCentreVerticallyCommand}"/>
                        <MenuItem Header="Aligner en _bas" Command="{Binding AlignBottomCommand}"/>
                        <Separator/>
                        <MenuItem Header="Répartir hori_zontalement" Command="{Binding DistributeHorizontallyCommand}"/>
                        <MenuItem Header="Répartir vertica_lement" Command="{Binding DistributeVerticallyCommand}"/>
                        <Separator/>
                        <!-- Le repère de l'alignement, posé une fois pour toutes les commandes
                             ci-dessus et pour celles de la barre principale : la zone de
                             composition, ou la page — et, page décochée, les blocs entre eux
                             dès qu'ils sont plusieurs. -->
                        <MenuItem Header="Par rapport aux mar_ges" ToggleType="CheckBox"
                                  IsChecked="{Binding AlignToMargins, Mode=TwoWay}"/>
                        <Separator/>
                        <MenuItem Header="Ajuster aux _marges" Command="{Binding FitToMarginsCommand}"/>
                        <Separator/>
                        <MenuItem Header="Repères de rè_gle">
                            <MenuItem Header="Ajouter un repère _horizontal" Command="{Binding AddHorizontalRulerGuideCommand}"/>
                            <MenuItem Header="Ajouter un repère _vertical" Command="{Binding AddVerticalRulerGuideCommand}"/>
                            <Separator/>
                            <MenuItem Header="_Effacer tous les repères" Command="{Binding ClearRulerGuidesCommand}"/>
                        </MenuItem>
                    </MenuItem>

                    <!-- Le menu Texte : la mise en forme du bloc entier, faute d'une sélection
                         dans le texte, et l'import d'un fichier, qui y passe avec son nom et
                         son libellé (poste B2 ; les tests et la recette le cherchent ainsi). -->
                    <MenuItem Header="_Texte">
                        <MenuItem Header="_Gras" InputGesture="Ctrl+G" Command="{Binding BasculerGrasCommand}"/>
                        <MenuItem Header="_Italique" InputGesture="Ctrl+I" Command="{Binding BasculerItaliqueCommand}"/>
                        <MenuItem Header="_Souligné" InputGesture="Ctrl+U" Command="{Binding SoulignerCommand}"/>
                        <Separator/>
                        <MenuItem Header="Aligner le texte à _gauche" Command="{Binding AlignerLeTexteCommand}"
                                  CommandParameter="{x:Static models:TextAlign.Left}"/>
                        <MenuItem Header="_Centrer le texte" Command="{Binding AlignerLeTexteCommand}"
                                  CommandParameter="{x:Static models:TextAlign.Center}"/>
                        <MenuItem Header="Aligner le texte à _droite" Command="{Binding AlignerLeTexteCommand}"
                                  CommandParameter="{x:Static models:TextAlign.Right}"/>
                        <MenuItem Header="_Justifier" Command="{Binding AlignerLeTexteCommand}"
                                  CommandParameter="{x:Static models:TextAlign.Justify}"/>
                        <Separator/>
                        <!-- Remplit le bloc de texte sélectionné, comme « Fichier texte » dans
                             Publisher ; le même geste est à la section Contenu du dock. -->
                        <MenuItem Name="MenuImporterTexte" Header="Importer un te_xte…" Click="OnImportText"
                                  IsEnabled="{Binding PeutImporterTexte}"/>
                    </MenuItem>

                    <MenuItem Header="_Page">
                        <MenuItem Header="_Ajouter une page" Command="{Binding AddPageCommand}"/>
                        <MenuItem Header="_Dupliquer la page" Command="{Binding DuplicatePageCommand}"/>
                        <MenuItem Header="_Supprimer la page" Command="{Binding DeletePageCommand}"/>
                    </MenuItem>

                    <MenuItem Header="_Affichage">
                        <MenuItem Header="_Repères" ToggleType="CheckBox" IsChecked="{Binding ShowGuides, Mode=TwoWay}"/>
                        <MenuItem Header="Rè_gles" ToggleType="CheckBox" IsChecked="{Binding ShowRulers, Mode=TwoWay}"/>
                        <Separator/>
                        <MenuItem Header="Zoom _avant" Command="{Binding ZoomInCommand}"/>
                        <MenuItem Header="Zoom a_rrière" Command="{Binding ZoomOutCommand}"/>
                        <MenuItem Header="Taille _réelle" Command="{Binding ZoomResetCommand}"/>
                    </MenuItem>

                    <!-- Le menu Fenêtre : les deux panneaux, chacun à son tour, ou les deux
                         d'un geste (B7). Une case de menu se lie dans un seul sens par défaut
                         (MenuItem.IsChecked, à la différence de ToggleButton.IsChecked) : sans
                         « Mode=TwoWay », le clic inverse la coche et le panneau reste là. -->
                    <MenuItem Header="Fe_nêtre">
                        <MenuItem Name="MenuPanneauPages" Header="Panneau _Pages" ToggleType="CheckBox"
                                  IsChecked="{Binding PanneauPagesVisible, Mode=TwoWay}"/>
                        <MenuItem Name="MenuDock" Header="_Dock" ToggleType="CheckBox"
                                  IsChecked="{Binding DockVisible, Mode=TwoWay}"/>
                        <Separator/>
                        <MenuItem Name="MenuReplierLesPanneaux" Header="_Replier les panneaux" InputGesture="Ctrl+F1"
                                  Command="{Binding ReplierLesPanneauxCommand}"/>
                    </MenuItem>
                </Menu>

                <TextBlock Grid.Column="2" x:Name="TitreDuDocument" Text="{Binding TitreDuDocument}"
                           FontSize="12" Foreground="{StaticResource Libelle}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========================================================= barre principale -->
        <!-- 44 px : le document, l'historique, l'alignement, l'ordre ; à droite le zoom et
             l'export. Avancer et reculer d'un rang, répartir et « par rapport aux marges »
             restent au menu Disposition. -->
        <Border DockPanel.Dock="Top" x:Name="BarrePrincipale" Height="45"
                Background="{StaticResource Blanc}" BorderBrush="{StaticResource Filet}"
                BorderThickness="0,0,0,1" Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="BoutonNouveau" Classes="ib" ToolTip.Tip="Nouveau (Ctrl+N)" Click="OnNew"
                            Content="{StaticResource IconeNouveau}"/>
                    <Button x:Name="BoutonOuvrir" Classes="ib" ToolTip.Tip="Ouvrir (Ctrl+O)" Click="OnOpen"
                            Content="{StaticResource IconeOuvrir}"/>
                    <Button x:Name="BoutonEnregistrer" Classes="ib" ToolTip.Tip="Enregistrer (Ctrl+S)" Click="OnSave"
                            Content="{StaticResource IconeEnregistrer}"/>
                    <Border Classes="separateur"/>
                    <!-- Grisés quand l'historique est vide. Une saisie du dock qui a déjà changé
                         le document n'a pas encore empilé son pas — elle ne le fait qu'à la
                         perte du focus — et Annuler la déferait : il reste actif pour elle
                         (PeutAnnuler), et son clic, qui prend le focus, la referme puis
                         l'annule. Rétablir se grise pendant ce temps : le pas qui vient videra
                         sa pile. -->
                    <Button x:Name="BoutonAnnuler" Classes="ib" ToolTip.Tip="Annuler (Ctrl+Z)"
                            Command="{Binding UndoCommand}" IsEnabled="{Binding PeutAnnuler}"
                            Content="{StaticResource IconeAnnuler}"/>
                    <Button x:Name="BoutonRetablir" Classes="ib" ToolTip.Tip="Rétablir (Ctrl+Y)"
                            Command="{Binding RedoCommand}" IsEnabled="{Binding PeutRetablir}"
                            Content="{StaticResource IconeRetablir}"/>
                    <Border Classes="separateur"/>
                    <TextBlock Classes="libelle" Text="Aligner" Margin="4,0,6,0" VerticalAlignment="Center"/>
                    <Button Classes="ib" ToolTip.Tip="Aligner à gauche" Command="{Binding AlignLeftCommand}"
                            Content="{StaticResource IconeAlignerAGauche}"/>
                    <Button Classes="ib" ToolTip.Tip="Centrer horizontalement"
                            Command="{Binding AlignCentreHorizontallyCommand}"
                            Content="{StaticResource IconeCentrerHorizontalement}"/>
                    <Button Classes="ib" ToolTip.Tip="Centrer verticalement"
                            Command="{Binding AlignCentreVerticallyCommand}"
                            Content="{StaticResource IconeCentrerVerticalement}"/>
                    <Button Classes="ib" ToolTip.Tip="Ajuster aux marges" Command="{Binding FitToMarginsCommand}"
                            Content="{StaticResource IconeAjusterAuxMarges}"/>
                    <Border Classes="separateur"/>
                    <TextBlock Classes="libelle" Text="Ordre" Margin="4,0,6,0" VerticalAlignment="Center"/>
                    <Button Classes="ib" ToolTip.Tip="Premier plan (Ctrl+Maj+F)" Command="{Binding BringToFrontCommand}"
                            Content="{StaticResource IconePremierPlan}"/>
                    <Button Classes="ib" ToolTip.Tip="Arrière-plan (Ctrl+Maj+B)" Command="{Binding SendToBackCommand}"
                            Content="{StaticResource IconeArrierePlan}"/>
                    <Button Classes="ib" ToolTip.Tip="Grouper (Ctrl+Maj+G)" Command="{Binding GroupSelectedCommand}"
                            Content="{StaticResource IconeGrouper}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <Button Classes="ib" ToolTip.Tip="Zoom arrière (Ctrl+−)" Command="{Binding ZoomOutCommand}"
                            Content="{StaticResource IconeZoomArriere}"/>
                    <TextBlock x:Name="ValeurDuZoom" Text="{Binding ZoomLabel}" FontSize="12" Width="44"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Classes="ib" ToolTip.Tip="Zoom avant (Ctrl++)" Command="{Binding ZoomInCommand}"
                            Content="{StaticResource IconeZoomAvant}"/>
                    <!-- Posé ici ; la page tenue dans la zone visible est le geste de I6,
                         qui écoute la demande du modèle de vue. -->
                    <Button x:Name="BoutonPageEntiere" Classes="commandeTexte" Content="Page entière"
                            Command="{Binding PageEntiereCommand}"/>
                </StackPanel>

                <Button Grid.Column="3" x:Name="BoutonExporter" Classes="principal" Click="OnExportPdf"
                        ToolTip.Tip="Exporter en PDF (Ctrl+E)" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ContentControl Content="{StaticResource IconeExporter}" VerticalAlignment="Center"/>
                        <TextBlock Text="Exporter en PDF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===================================================== barre contextuelle -->
        <!-- Sa place, de hauteur constante (règle 3) ; I3 l'a remplie. La transaction d'édition
             s'y ouvre et s'y ferme au focus, comme dans le dock (règle 2). -->
        <views:BarreContextuelle DockPanel.Dock="Top" x:Name="BarreContextuelle"
                                 GotFocus="OnPropertyPanelGotFocus" LostFocus="OnPropertyPanelLostFocus"/>

        <!-- ============================================================ barre d'état -->
        <!-- Le message, le curseur, la position et la taille du bloc (A6), la page, le
             format et le zoom. Les cases de A6 sont de largeur fixe, comme avant : elles se
             rafraîchissent à chaque mouvement du pointeur, et une barre dont les cases se
             déplacent à chaque chiffre ne se lit plus. -->
        <Border DockPanel.Dock="Bottom" x:Name="BarreDEtat" Height="27"
                Background="{StaticResource Blanc}" BorderBrush="{StaticResource Filet}"
                BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="PositionDuCurseur" Text="{Binding CursorLabel}" Margin="18,0,0,0"/>
                <TextBlock Grid.Column="2" x:Name="PositionDuBloc" Margin="18,0,0,0"
                           Width="150" TextAlignment="Right"
                           Text="{Binding FramePositionLabel}"
                           IsVisible="{Binding HasSelection}"/>
                <!-- Sans marge à gauche : la case de position l'en sépare déjà, et les deux
                     se lisent comme un couple. -->
                <TextBlock Grid.Column="3" x:Name="TailleDuBloc" Margin="0"
                           Width="130" TextAlignment="Right"
                           Text="{Binding FrameSizeLabel}"
                           IsVisible="{Binding HasSelection}"/>
                <TextBlock Grid.Column="4" x:Name="PageSurPages" Margin="18,0,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Page {0} sur {1}">
                            <Binding Path="CurrentPageNumber"/>
                            <Binding Path="Document.Pages.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="5" x:Name="FormatDeLaPage" Margin="18,0,0,0">
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static conv:FormatDePage.Instance}">
                            <Binding Path="Document.PageWidth"/>
                            <Binding Path="Document.PageHeight"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0">
                    <TextBlock Text="{Binding ZoomLabel}"/>
                    <Slider x:Name="CurseurDuZoom" Classes="zoom" VerticalAlignment="Center"
                            Minimum="{x:Static conv:EchelleDuZoom.Minimum}"
                            Maximum="{x:Static conv:EchelleDuZoom.Maximum}"
                            Value="{Binding Zoom, Converter={x:Static conv:EchelleDuZoom.Instance}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================== espace de travail -->
        <Grid x:Name="EspaceDeTravail" ColumnDefinitions="Auto,Auto,*,Auto">

            <!-- Le rail d'outils, 46 px et un filet. Les outils seuls, dans l'ordre de la
                 maquette ; un outil armé est plein d'accent. -->
            <Border Grid.Column="0" x:Name="RailDOutils" Width="47"
                    Background="{StaticResource Blanc}" BorderBrush="{StaticResource Filet}"
                    BorderThickness="0,0,1,0">
                <StackPanel Spacing="3" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <ToggleButton Classes="ib" ToolTip.Tip="Sélection (V)" Content="{StaticResource IconeSelection}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Select}"/>
                    <!-- La main (I6) : elle fait glisser la planche ; Espace tenu fait de même
                         sans changer d'outil. -->
                    <ToggleButton x:Name="OutilMain" Classes="ib" ToolTip.Tip="Main (Espace)" Content="{StaticResource IconeMain}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Main}"/>
                    <Border Classes="filetDuRail"/>
                    <ToggleButton Classes="ib" ToolTip.Tip="Bloc de texte (T)" Content="{StaticResource IconeBlocDeTexte}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Text}"/>
                    <ToggleButton Classes="ib" ToolTip.Tip="Titre (H)" Content="{StaticResource IconeTitre}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Heading}"/>
                    <!-- L'image ne se trace pas : elle demande d'abord un fichier. Une action,
                         rangée parmi les outils comme la maquette la range. -->
                    <Button Classes="ib" ToolTip.Tip="Image…" Click="OnInsertImage" Content="{StaticResource IconeImage}"/>
                    <!-- « B » comme bande : « T » appartient au texte, et ces tableaux-là sont
                         des bandes à trois cases. -->
                    <ToggleButton Classes="ib" ToolTip.Tip="Tableau (B)" Content="{StaticResource IconeTableau}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Table}"/>
                    <Border Classes="filetDuRail"/>
                    <ToggleButton Classes="ib" ToolTip.Tip="Rectangle (R)" Content="{StaticResource IconeRectangle}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Rectangle}"/>
                    <ToggleButton Classes="ib" ToolTip.Tip="Ellipse (E)" Content="{StaticResource IconeEllipse}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Ellipse}"/>
                    <!-- La ligne (A10) : un trait, tracé d'une extrémité à l'autre ; Maj le tient
                         à 0, 45 ou 90°. -->
                    <ToggleButton x:Name="OutilLigne" Classes="ib" ToolTip.Tip="Ligne (L)" Content="{StaticResource IconeLigne}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Line}"/>
                    <!-- La pipette n'est pas posée. Puis la loupe (I6) : un clic zoome en avant,
                         Alt + clic en arrière, le point visé restant sous le pointeur. -->
                    <Border Classes="filetDuRail"/>
                    <ToggleButton x:Name="OutilZoom" Classes="ib" ToolTip.Tip="Zoom (Z)" Content="{StaticResource IconeLoupe}"
                                  IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Zoom}"/>
                </StackPanel>
            </Border>

            <!-- Le panneau Pages, 168 px et un filet : un en-tête avec « + », puis les pages.
                 Pas de section Gabarits : les pages maîtres ne sont pas faites. -->
            <Border Grid.Column="1" x:Name="PanneauPages" Width="169"
                    Background="{StaticResource FondPanneau}" BorderBrush="{StaticResource Filet}"
                    BorderThickness="0,0,1,0" IsVisible="{Binding PanneauPagesVisible}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,10,12,6">
                        <TextBlock Text="Pages" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BoutonAjouterPage" Classes="ib" Width="24" Height="24"
                                ToolTip.Tip="Ajouter une page" Command="{Binding AddPageCommand}"
                                Content="{StaticResource IconeAjouterPage}"/>
                    </Grid>
                    <!-- Toujours une page choisie (relecture de I5) : un Ctrl + clic sur la
                         vignette courante la désélectionnait, et laissait la fenêtre sans
                         page courante — plus de planche, plus de cadre d'accent. -->
                    <ListBox x:Name="ListeDesPages" Classes="pages" Margin="0,6,0,12"
                             ItemsSource="{Binding Document.Pages}"
                             SelectionMode="AlwaysSelected"
                             SelectedItem="{Binding CurrentPage}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Page">
                                <views:EntreeDePage/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- La planche : le poste I4 la refait, celui-ci n'y touche pas. -->
            <views:PageCanvas Grid.Column="2" x:Name="PageView"/>

            <!-- Le dock, 292 px et un filet, à quatre onglets. C'est l'utilisateur qui choisit
                 l'onglet ; le premier suit la sélection comme le panneau d'avant. -->
            <Border Grid.Column="3" x:Name="Dock" Width="293"
                    Background="{StaticResource Blanc}" BorderBrush="{StaticResource Filet}"
                    BorderThickness="1,0,0,0" IsVisible="{Binding DockVisible}">
                <TabControl x:Name="OngletsDuDock" Classes="dock">

                    <!-- ============================================ onglet Propriétés -->
                    <TabItem x:Name="OngletProprietes" Header="Propriétés">
                        <Grid RowDefinitions="*,Auto">
                            <!-- Le dock modifie le modèle par liaison directe : la saisie d'un
                                 champ s'encadre d'une transaction, ouverte au focus et
                                 refermée à sa perte, ce qui en fait un pas d'annulation. -->
                            <ScrollViewer x:Name="ProprietesDuBloc" HorizontalScrollBarVisibility="Disabled"
                                          GotFocus="OnPropertyPanelGotFocus" LostFocus="OnPropertyPanelLostFocus">
                                <StackPanel>
                                    <TextBlock Classes="aide" Text="Aucun bloc sélectionné : la page se règle à l'onglet Document."
                                               Margin="12" IsVisible="{Binding !HasSelection}"/>

                                    <!-- À plusieurs blocs, le dock ne montre aucun champ : éditer les
                                         valeurs de l'un d'eux modifierait en silence celui qu'on ne
                                         regarde pas. Restent les commandes de disposition, qui, elles,
                                         valent pour l'ensemble. -->
                                    <StackPanel IsVisible="{Binding HasMultipleSelection}" Margin="12" Spacing="4">
                                        <TextBlock Text="{Binding SelectionLabel}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Classes="aide" Text="Alignement, répartition, ordre et déplacement valent pour l'ensemble. Les propriétés s'éditent bloc par bloc."/>
                                    </StackPanel>

                                    <!-- Position et taille, commune à tous les blocs. Chaque section du
                                         bloc est tirée d'un gabarit par sorte de bloc, construit une
                                         fois et gardé, masqué sans bloc de sa sorte : la reconstruire à
                                         chaque sélection figeait la pression du pointeur (poste Q23,
                                         voir GabaritsGardes). -->
                                    <views:GabaritsGardes Bloc="{Binding SingleSelected}">
                                        <views:GabaritsGardes.DataTemplates>
                                            <DataTemplate DataType="models:Frame">
                                                <StackPanel>
                                                    <ToggleButton Classes="titreSection premiere"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionPositionOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Position et taille"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Grid Classes="contenuDeSection" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto"
                                                          IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionPositionOuverte}">
                                                        <DockPanel Grid.Row="0" Grid.Column="0" IsVisible="{Binding !IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="X" Width="12" Margin="0,0,6,0"/>
                                                            <NumericUpDown x:Name="ChampX" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1"
                                                                           Value="{Binding X, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="0" Grid.Column="2" IsVisible="{Binding !IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Y" Width="12" Margin="0,0,6,0"/>
                                                            <NumericUpDown x:Name="ChampY" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1"
                                                                           Value="{Binding Y, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="2" Grid.Column="0" IsVisible="{Binding !IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="L" Width="12" Margin="0,0,6,0"/>
                                                            <!-- L et H passent par le modèle de vue : la case « Conserver
                                                                 les proportions » y entraîne l'autre côté (I6). -->
                                                            <NumericUpDown x:Name="ChampLargeur" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1" Minimum="2"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).LargeurDuBloc, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="2" Grid.Column="2" IsVisible="{Binding !IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="H" Width="12" Margin="0,0,6,0"/>
                                                            <NumericUpDown x:Name="ChampHauteur" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1" Minimum="2"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).HauteurDuBloc, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="4" Grid.Column="0">
                                                            <ContentControl Content="{StaticResource IconeRotation}" Width="12" Margin="0,0,6,0"
                                                                            VerticalAlignment="Center" ToolTip.Tip="Rotation"/>
                                                            <NumericUpDown x:Name="ChampAngle" Classes="champ" TextConverter="{x:Static conv:Unite.Degres}" Increment="1"
                                                                           Minimum="-360" Maximum="360"
                                                                           Value="{Binding Rotation, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                                        </DockPanel>
                                                        <!-- Posée par I2. Cochée, un coin tiré et la saisie de L ou de H
                                                             gardent le rapport du bloc (I6) ; Maj, pendant le glissé, fait
                                                             l'inverse. -->
                                                        <CheckBox Grid.Row="4" Grid.Column="2" x:Name="ConserverLesProportions" Classes="case" IsVisible="{Binding !IsLine}"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).ConserverLesProportions}">
                                                            <TextBlock Text="Conserver les proportions" TextWrapping="Wrap"/>
                                                        </CheckBox>
                                                        <!-- Un trait n'a pas de cadre à saisir, mais deux extrémités (A10) :
                                                             elles prennent la place de X, Y, L et H, et la case des
                                                             proportions se tait. L'angle reste, que le trait suit. -->
                                                        <DockPanel Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="X1" Width="16" Margin="0,0,4,0"/>
                                                            <NumericUpDown x:Name="ChampDebutX" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).DebutDuTraitX, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="0" Grid.Column="2" IsVisible="{Binding IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Y1" Width="16" Margin="0,0,4,0"/>
                                                            <NumericUpDown x:Name="ChampDebutY" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).DebutDuTraitY, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="2" Grid.Column="0" IsVisible="{Binding IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="X2" Width="16" Margin="0,0,4,0"/>
                                                            <NumericUpDown x:Name="ChampFinX" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).FinDuTraitX, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="2" Grid.Column="2" IsVisible="{Binding IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Y2" Width="16" Margin="0,0,4,0"/>
                                                            <NumericUpDown x:Name="ChampFinY" Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}" Increment="1"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).FinDuTraitY, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </DockPanel>
                                                        <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Nom" Margin="0,0,6,0"/>
                                                            <TextBox x:Name="ChampNom" Classes="champ" Text="{Binding Name}"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </views:GabaritsGardes.DataTemplates>
                                    </views:GabaritsGardes>

                                    <!-- Les sections propres au type de bloc. -->
                                    <views:GabaritsGardes Bloc="{Binding SingleSelected}">
                                        <views:GabaritsGardes.DataTemplates>

                                            <DataTemplate DataType="models:TextFrame">
                                                <StackPanel>
                                                    <!-- Cadre de texte : ce que le bloc fait de son texte. -->
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionCadreOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Cadre de texte"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Grid Classes="contenuDeSection" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,Auto"
                                                          IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionCadreOuverte}">
                                                        <!-- Les colonnes du BLOC, où le texte coule de l'une à l'autre —
                                                             à ne pas confondre avec celles de la grille, à l'onglet
                                                             Document, qui sont des repères d'aimantation posés sur la
                                                             page. Minimum à un : zéro ou moins ne veut rien dire. -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Colonnes"/>
                                                            <NumericUpDown x:Name="NombreDeColonnes" Classes="champ"
                                                                           FormatString="0" Increment="1" Minimum="1" Maximum="20"
                                                                           Value="{Binding Columns}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Gouttière"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="1" Minimum="0"
                                                                           Value="{Binding ColumnGap, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>
                                                        <!-- Un champ quand les quatre marges sont égales, quatre sinon :
                                                             le modèle en garde quatre (C6). -->
                                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Marges intérieures"/>
                                                            <NumericUpDown x:Name="MargeInterieureCommune" Classes="champ"
                                                                           TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="0.5" Minimum="0"
                                                                           IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).MargesInterieuresEgales}"
                                                                           Value="{Binding #Root.((vm:MainWindowViewModel)DataContext).MargeInterieure, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                            <Grid ColumnDefinitions="*,4,*" RowDefinitions="Auto,4,Auto"
                                                                  IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).MargesInterieuresDistinctes}">
                                                                <NumericUpDown Grid.Row="0" Grid.Column="0" Classes="champ marge" ToolTip.Tip="Gauche"
                                                                               TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="0.5" Minimum="0"
                                                                               Value="{Binding PaddingLeft, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                                <NumericUpDown Grid.Row="0" Grid.Column="2" Classes="champ marge" ToolTip.Tip="Droite"
                                                                               TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="0.5" Minimum="0"
                                                                               Value="{Binding PaddingRight, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                                <NumericUpDown Grid.Row="2" Grid.Column="0" Classes="champ marge" ToolTip.Tip="Haut"
                                                                               TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="0.5" Minimum="0"
                                                                               Value="{Binding PaddingTop, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                                <NumericUpDown Grid.Row="2" Grid.Column="2" Classes="champ marge" ToolTip.Tip="Bas"
                                                                               TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="0.5" Minimum="0"
                                                                               Value="{Binding PaddingBottom, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <!-- Deux alignements et non un : l'horizontal cale les lignes dans
                                                             leur largeur, le vertical cale le texte entier dans la hauteur
                                                             du bloc. Publisher les présente aussi séparément. -->
                                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Alignement vertical"/>
                                                            <ComboBox Classes="champ"
                                                                      ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).VerticalAlignments}"
                                                                      SelectedItem="{Binding VerticalAlign}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={x:Static conv:Libelle.Instance}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <!-- L'alerte d'excédent (I9) : les lignes du bloc que le bloc
                                                             ne montre pas, comptées par le noyau sur la composition de
                                                             l'écran ; à zéro, rien. Elle suit la frappe, sans attendre
                                                             un changement de sélection. L'icône prend la couleur du
                                                             texte de l'alerte. -->
                                                        <Panel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="PlaceDeLAlerteDExcedent">
                                                            <Border x:Name="AlerteDExcedent" Margin="0,8,0,0" Padding="9,7"
                                                                    CornerRadius="6" Background="{StaticResource FondAlerte}"
                                                                    TextElement.Foreground="{StaticResource TexteAlerte}"
                                                                    TextElement.FontSize="11.5"
                                                                    IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).TexteEnExcedent}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <ContentControl VerticalAlignment="Center" Content="{StaticResource IconeAlerte}"/>
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               Text="{Binding #Root.((vm:MainWindowViewModel)DataContext).AlerteDExcedent}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Panel>
                                                    </Grid>

                                                    <!-- Paragraphe : les retraits et les espacements.
                                                         L'alignement et l'interligne sont montés dans la
                                                         barre contextuelle (I3), et ont quitté le dock
                                                         (règle 1). Ils valent pour tout le bloc ; les écarts
                                                         paragraphe par paragraphe se lisent et s'écrivent
                                                         dans le fichier, mais ne se règlent pas encore ici. -->
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionParagrapheOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Paragraphe"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Grid Classes="contenuDeSection" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto"
                                                          IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionParagrapheOuverte}">
                                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Retrait à gauche"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="1" Minimum="-350"
                                                                           Value="{Binding IndentLeft, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Retrait à droite"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="1" Minimum="-350"
                                                                           Value="{Binding IndentRight, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>
                                                        <!-- Minimum négatif, et ce n'est pas un détail : le retrait de
                                                             première ligne négatif est la seule façon de composer une
                                                             liste à puces, et un minimum à zéro le rendrait
                                                             inatteignable au dock tout en marchant dans le fichier. -->
                                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Première ligne"/>
                                                            <NumericUpDown x:Name="RetraitPremiereLigne" Classes="champ"
                                                                           TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="1" Minimum="-350"
                                                                           Value="{Binding IndentFirstLine, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="aide" VerticalAlignment="Bottom"
                                                                   Text="Négative, elle pend : une liste à puces."/>
                                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Espace avant"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="1" Minimum="0"
                                                                           Value="{Binding SpaceBefore, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Espace après"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="1" Minimum="0"
                                                                           Value="{Binding SpaceAfter, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Contenu : un champ calculé, ou le texte saisi. -->
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionContenuOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Contenu"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <StackPanel Classes="contenuDeSection" Spacing="6"
                                                                IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionContenuOuverte}">
                                                        <ComboBox Classes="champ"
                                                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).TextFieldOptions}"
                                                                  SelectedValue="{Binding Field}"
                                                                  SelectedValueBinding="{Binding Kind}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="models:FieldOption">
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <!-- Le texte saisi reste là sous le champ, et se retrouve
                                                             intact quand on repasse à « Aucun ». -->
                                                        <TextBox x:Name="SaisieDuTexte" Classes="champ" Text="{Binding Saisie}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                 Height="110" VerticalContentAlignment="Top" Padding="8,6"
                                                                 IsEnabled="{Binding !HasField}"/>
                                                        <TextBlock Classes="aide" IsVisible="{Binding HasField}"
                                                                   Text="Le contenu est calculé à l'affichage et à l'export ; il ne se saisit pas sur la page."/>
                                                        <Button Name="BoutonImporterTexte" Classes="boutonDuDock" Content="Importer un texte…"
                                                                HorizontalAlignment="Left" Click="OnImportText"
                                                                IsEnabled="{Binding !HasField}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <!-- Rien de propre au rectangle ni à l'ellipse : tout ce qu'ils
                                                 avaient — fond, contour, épaisseur, arrondi — est commun à tous
                                                 les blocs et se règle plus bas. Un trait (A10), lui, a ses
                                                 pointes de flèche, une à chaque bout ; son épaisseur et sa
                                                 couleur sont celles du contour. -->
                                            <DataTemplate DataType="models:ShapeFrame">
                                                <StackPanel IsVisible="{Binding IsLine}">
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionTraitOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Trait"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <StackPanel Classes="contenuDeSection" Spacing="6"
                                                                IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionTraitOuverte}">
                                                        <CheckBox x:Name="PointeAuDebut" Classes="case" IsChecked="{Binding StartArrow}">
                                                            <TextBlock Text="Pointe de flèche au début"/>
                                                        </CheckBox>
                                                        <CheckBox x:Name="PointeALaFin" Classes="case" IsChecked="{Binding EndArrow}">
                                                            <TextBlock Text="Pointe de flèche à la fin"/>
                                                        </CheckBox>
                                                        <TextBlock Classes="aide" Text="L'épaisseur, le tracé et la couleur du trait sont ceux du contour, plus bas. Maj, sur une extrémité, le tient à 0, 45 ou 90°."/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="models:GroupFrame">
                                                <StackPanel>
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionGroupeOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Groupe"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <StackPanel Classes="contenuDeSection" Spacing="4"
                                                                IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionGroupeOuverte}">
                                                        <TextBlock FontSize="12" Text="{Binding Children.Count, StringFormat='{}{0} blocs réunis'}"/>
                                                        <TextBlock Classes="aide" Text="Le groupe se déplace, se tourne et se redimensionne d'une pièce ; le redimensionner met ses blocs à la même échelle. Pour en retoucher un, dissociez (Ctrl+Maj+H)."/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="models:TableFrame">
                                                <StackPanel>
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionTableauOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Tableau"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <StackPanel Classes="contenuDeSection" Spacing="8"
                                                                IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionTableauOuverte}">
                                                        <TextBlock Classes="aide" Text="Les colonnes et les lignes font la taille du bloc : les élargir l'élargit, le redimensionner les mesure à la même aune."/>

                                                        <Grid ColumnDefinitions="*,8,*">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Classes="libelle libelleAuDessus" Text="Lignes"/>
                                                                <NumericUpDown Classes="champ" FormatString="0" Increment="1"
                                                                               Minimum="1" Maximum="40" Value="{Binding RowCount}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Classes="libelle libelleAuDessus" Text="Colonnes"/>
                                                                <NumericUpDown Classes="champ" FormatString="0" Increment="1"
                                                                               Minimum="1" Maximum="40" Value="{Binding ColumnCount}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- La police, le corps, l'interligne, le gras, l'italique et
                                                             la couleur du texte de toutes les cases sont montés
                                                             dans la barre contextuelle (I3). -->
                                                        <StackPanel>
                                                            <TextBlock Classes="libelle libelleAuDessus" Text="Marge intérieure des cases"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                                           Increment="0.5" Minimum="0"
                                                                           Value="{Binding CellPadding, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                        </StackPanel>

                                                        <!-- La grille se règle pour toutes les cases à la fois ; chacune
                                                             garde pourtant son contour dans le fichier, comme Publisher
                                                             les décrit. Personne ne veut cocher trois cases pour
                                                             encadrer une bande. -->
                                                        <CheckBox Classes="case" Content="Encadrer les cases" IsChecked="{Binding HasGrid}"/>
                                                        <StackPanel IsEnabled="{Binding HasGrid}" Spacing="3">
                                                            <views:SelecteurDeCouleur Valeur="{Binding GridColor}"
                                                                   Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                                                            <TextBlock Classes="libelle" Text="Épaisseur des filets" Margin="0,5,0,0"/>
                                                            <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Points}"
                                                                           Increment="0.5" Minimum="0"
                                                                           Value="{Binding GridThickness, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                                        </StackPanel>

                                                        <StackPanel Spacing="3">
                                                            <TextBlock Classes="libelle" Text="Largeur des colonnes"/>
                                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Spacing="4"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="models:TableColumn">
                                                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}"
                                                                                       Increment="1" Minimum="1"
                                                                                       Value="{Binding Width, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <StackPanel Spacing="3">
                                                            <TextBlock Classes="libelle" Text="Hauteur des lignes"/>
                                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Spacing="4"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="models:TableRow">
                                                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Millimetres}"
                                                                                       Increment="1" Minimum="1"
                                                                                       Value="{Binding Height, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- Les cases se règlent ici et non sur la page : il n'y a pas
                                                             de sélection à l'intérieur d'un bloc, et une bande en
                                                             compte trois. Chacune est nommée par son rang, ligne puis
                                                             colonne, pour qu'on sache laquelle on modifie. -->
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Cases" Margin="0,4,0,0"/>
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="models:TableCell">
                                                                    <Border BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0" Padding="0,6">
                                                                        <StackPanel Spacing="4">
                                                                            <TextBlock Classes="libelle" Text="{Binding Label}"/>
                                                                            <TextBox Classes="champ cellText"
                                                                                     Text="{Binding Saisie}" AcceptsReturn="True"
                                                                                     TextWrapping="Wrap" Height="54" Padding="8,6"
                                                                                     VerticalContentAlignment="Top"/>
                                                                            <Grid ColumnDefinitions="*,8,Auto">
                                                                                <ComboBox Grid.Column="0" Classes="champ"
                                                                                          ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).TextAlignments}"
                                                                                          SelectedItem="{Binding Align}">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding Converter={x:Static conv:Libelle.Instance}}"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <CheckBox Grid.Column="2" Classes="case" Content="Fond"
                                                                                          IsChecked="{Binding HasFill}"/>
                                                                            </Grid>
                                                                            <views:SelecteurDeCouleur
                                                                                   IsEnabled="{Binding HasFill}" Valeur="{Binding FillColor}"
                                                                                   Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="models:ImageFrame">
                                                <StackPanel>
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionImageOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Image"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <StackPanel Classes="contenuDeSection" Spacing="3"
                                                                IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionImageOuverte}">
                                                        <TextBlock Classes="aide" Text="{Binding Path}" IsVisible="{Binding !HasField}"/>

                                                        <TextBlock Classes="libelle" Text="Source" Margin="0,5,0,0"/>
                                                        <ComboBox Classes="champ"
                                                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).ImageFieldOptions}"
                                                                  SelectedValue="{Binding Field}"
                                                                  SelectedValueBinding="{Binding Kind}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="models:FieldOption">
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBlock Classes="aide" IsVisible="{Binding HasField}"
                                                                   Text="L'image vient du jeu de coordonnées : elle change avec lui, et suit celui qui ouvre le document."/>

                                                        <TextBlock Classes="libelle" Text="Cadrage" Margin="0,5,0,0"/>
                                                        <ComboBox Classes="champ"
                                                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).ImageFits}"
                                                                  SelectedItem="{Binding Fit}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={x:Static conv:Libelle.Instance}}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                        </views:GabaritsGardes.DataTemplates>
                                    </views:GabaritsGardes>

                                    <!-- Fond et contour, communs à tous les blocs. En dernier, après ce
                                         qui est propre au type : d'abord ce qu'est le bloc, ensuite
                                         comment il est habillé. -->
                                    <views:GabaritsGardes Bloc="{Binding SingleSelected}">
                                        <views:GabaritsGardes.DataTemplates>
                                            <DataTemplate DataType="models:Frame">
                                                <StackPanel>
                                                    <ToggleButton Classes="titreSection"
                                                                  IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionFondOuverte}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Panel>
                                                                <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                                                <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                                            </Panel>
                                                            <TextBlock Text="Fond et contour"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <StackPanel Classes="contenuDeSection" Spacing="8"
                                                                IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).SectionFondOuverte}">
                                                        <!-- Le fond : « Aucun », ou l'une des quatre sortes. Sans fond,
                                                             ce qui passe sous le bloc reste visible. -->
                                                        <DockPanel IsVisible="{Binding !IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Fond" Width="52" Margin="0,0,8,0"/>
                                                            <!-- La vignette montre le fond ; elle ne le règle pas : la
                                                                 liste et le sélecteur au-dessous le font, un contrôle par
                                                                 propriété (règle 1). -->
                                                            <Border x:Name="VignetteDuFond" Classes="vignette" Classes.aucune="{Binding !HasFill}">
                                                                <views:FondBloc Fond="{Binding Fill}" IsVisible="{Binding HasFill}"
                                                                                views:JeuAffiche.Charte="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.Charte}"/>
                                                            </Border>
                                                            <ComboBox x:Name="SorteDeFond" Classes="champ"
                                                                      ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).SortesDeFond}"
                                                                      SelectedItem="{Binding #Root.((vm:MainWindowViewModel)DataContext).FondDuBloc}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="vm:OptionDeFond">
                                                                        <TextBlock Text="{Binding Libelle}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>
                                                        <!-- L'aplat se règle ici et non dans le gabarit du remplissage :
                                                             le sélecteur de couleur renvoie ce qu'il lit dès qu'il
                                                             s'affiche, et il ne doit écrire que si le fond est bien un
                                                             aplat. -->
                                                        <StackPanel IsVisible="{Binding FillIsSolid}" Spacing="3">
                                                            <views:SelecteurDeCouleur Valeur="{Binding FillColor}"
                                                                   Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                                                            <DockPanel Margin="0,5,0,0">
                                                                <TextBlock Classes="libelle libelleAGauche" Text="Opacité" Width="52" Margin="0,0,8,0"/>
                                                                <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Pourcent}"
                                                                               Increment="5" Minimum="0" Maximum="100"
                                                                               Value="{Binding FillOpacity, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                        <!-- Le dégradé, l'image et la teinte, par les gabarits que le fond
                                                             de page partage. -->
                                                        <ContentControl Content="{Binding Fill}"/>

                                                        <!-- Le contour : « Aucun », ou l'un des trois traits, et son
                                                             épaisseur — centrée sur le bord du bloc, en points. -->
                                                        <DockPanel>
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Contour" Width="52" Margin="0,0,8,0"/>
                                                            <Border x:Name="VignetteDuContour" Classes="vignette" Classes.aucune="{Binding !HasStroke}">
                                                                <Border IsVisible="{Binding HasStroke}">
                                                                    <Border.Background>
                                                                        <MultiBinding Converter="{x:Static conv:CouleurDuJeu.Pinceau}">
                                                                            <Binding Path="StrokeColor"/>
                                                                            <Binding Path="#Root.((vm:MainWindowViewModel)DataContext).Document.Charte"/>
                                                                        </MultiBinding>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Border>
                                                            <NumericUpDown x:Name="EpaisseurDuContour" Classes="champ" Width="64" Margin="0,0,8,0"
                                                                           TextConverter="{x:Static conv:Unite.Points}"
                                                                           Increment="0.5" Minimum="0" IsEnabled="{Binding HasStroke}"
                                                                           Value="{Binding StrokeThickness, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                                            <ComboBox x:Name="SorteDeContour" Classes="champ"
                                                                      ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).SortesDeContour}"
                                                                      SelectedItem="{Binding #Root.((vm:MainWindowViewModel)DataContext).ContourDuBloc}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="vm:OptionDeContour">
                                                                        <TextBlock Text="{Binding Libelle}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>
                                                        <views:SelecteurDeCouleur IsVisible="{Binding HasStroke}" Valeur="{Binding StrokeColor}"
                                                               Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>

                                                        <DockPanel IsVisible="{Binding !IsLine}">
                                                            <TextBlock Classes="libelle libelleAGauche" Text="Arrondi" Width="52" Margin="0,0,8,0"/>
                                                            <NumericUpDown Classes="champ" Width="64" HorizontalAlignment="Left"
                                                                           TextConverter="{x:Static conv:Unite.Points}"
                                                                           Increment="1" Minimum="0"
                                                                           Value="{Binding CornerRadius, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </views:GabaritsGardes.DataTemplates>
                                    </views:GabaritsGardes>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Blocs de la page, au pied du dock : la pile lue de l'avant vers
                                 le fond — l'avant en tête, comme la maquette et Publisher —, et
                                 qui se réordonne en y tirant un bloc. Le trait d'insertion est
                                 posé par-dessus, dans un calque qui ne reçoit pas le pointeur.
                                 Hors du défilement des propriétés, et de sa transaction : le
                                 glissé ouvre son propre pas d'annulation. -->
                            <Border Grid.Row="1" x:Name="BlocsDeLaPage" Background="{StaticResource FondPanneau}"
                                    BorderBrush="{StaticResource FiletFort}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,9,12,5">
                                        <TextBlock Text="Blocs de la page" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Classes="libelle" Text="avant ↑" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Panel Margin="6,0,6,8">
                                        <!-- Six lignes de 26, comme la maquette en montre six : au-delà, la
                                             liste défile, et les sections gardent la hauteur du dock. -->
                                        <ListBox x:Name="ListeDesBlocs" Classes="blocs" MaxHeight="156"
                                                 ItemsSource="{Binding CurrentPage.Frames, Converter={x:Static conv:VueInversee.Instance}}"
                                                 SelectedItem="{Binding Selected}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="models:Frame">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <!-- L'œil (poste I8) : un clic masque le bloc, ou le
                                                             montre, en un pas d'annulation, sans le
                                                             sélectionner ni prendre le focus. Un bloc masqué
                                                             reste dans la liste, l'œil fermé, et s'y
                                                             sélectionne. L'œil ouvert est celui de la
                                                             maquette ; elle n'a pas d'œil fermé, qui en
                                                             garde le trait et la couleur : la paupière
                                                             baissée, trois cils. -->
                                                        <Panel x:Name="PlaceDeLOeil" Width="14" Height="14">
                                                            <Button x:Name="OeilDuBloc" Classes="oeil"
                                                                    ToolTip.Tip="Masquer ou afficher le bloc"
                                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).BasculerLaVisibiliteCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Panel>
                                                                    <ContentControl Content="{StaticResource IconeOeil}"
                                                                                    IsVisible="{Binding Visible}"/>
                                                                    <Viewbox x:Name="OeilFerme" Width="14" Height="14"
                                                                             IsVisible="{Binding !Visible}">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path StrokeThickness="1.8" StrokeLineCap="Round"
                                                                                  Stroke="{StaticResource Libelle}"
                                                                                  Data="M2 10s3.5 6 10 6 10-6 10-6M5.5 13.2 4 15.8M12 16v2.8M18.5 13.2 20 15.8"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Panel>
                                                            </Button>
                                                        </Panel>
                                                        <Border Width="14" Height="14" CornerRadius="3"
                                                                Background="{StaticResource FondInitiale}">
                                                            <TextBlock Text="{Binding Converter={x:Static conv:InitialeDuType.Instance}}"
                                                                       FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TexteInitiale}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                            <Rectangle x:Name="TraitDInsertion" Height="2" IsVisible="False"
                                                       Fill="{StaticResource Accent}"/>
                                        </Canvas>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ================================================ onglet Styles -->
                    <!-- Le jeu de polices du document : le titre et le corps, par référence
                         (C5b). Le style de paragraphe nommé n'est pas fait. -->
                    <TabItem x:Name="OngletStyles" Header="Styles">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      GotFocus="OnPropertyPanelGotFocus" LostFocus="OnPropertyPanelLostFocus">
                            <StackPanel Margin="12" Spacing="3">
                                <TextBlock Classes="libelle" Text="Jeu de polices"/>
                                <ComboBox x:Name="JeuDePolices" Classes="champ" Height="NaN" MinHeight="26"
                                          ItemsSource="{Binding FontSchemes}"
                                          SelectedItem="{Binding ChosenFontScheme}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:JeuDePolices">
                                            <StackPanel Margin="0,3">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Libelle}">
                                                    <Run Text="{Binding Heading}" FontFamily="{Binding Heading, Converter={x:Static conv:Conv.Font}}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding Body}" FontFamily="{Binding Body, Converter={x:Static conv:Conv.Font}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="aide" Margin="0,4,0,0"
                                           Text="Le titre et le corps du jeu ouvrent la liste des polices : un bloc qui les prend suit le jeu quand on en change."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================================== onglet Couleurs -->
                    <!-- Le jeu de couleurs du document, comme « Format ▸ Color Schemes » de
                         Publisher (fiche 01) : changer de jeu recolore les blocs qui y font
                         référence, et eux seuls (C5b). Pas de nuancier libre : le sélecteur
                         de chaque couleur a déjà le sien. -->
                    <TabItem x:Name="OngletCouleurs" Header="Couleurs">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      GotFocus="OnPropertyPanelGotFocus" LostFocus="OnPropertyPanelLostFocus">
                            <StackPanel Margin="12" Spacing="3">
                                <TextBlock Classes="libelle" Text="Jeu de couleurs"/>
                                <ComboBox x:Name="JeuDeCouleurs" Classes="champ"
                                          ItemsSource="{Binding ColorSchemes}"
                                          SelectedItem="{Binding ChosenColorScheme}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:JeuDeCouleurs">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ItemsControl ItemsSource="{Binding Couleurs}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="x:String">
                                                            <Border Width="12" Height="12" BorderBrush="{StaticResource BordChamp}" BorderThickness="1"
                                                                    Background="{Binding Converter={x:Static conv:Conv.Brush}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="aide" Margin="0,4,0,0"
                                           Text="Une pastille du jeu fait suivre le jeu à la couleur ; une couleur choisie au sélecteur reste libre."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================================== onglet Document -->
                    <TabItem x:Name="OngletDocument" Header="Document">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      GotFocus="OnPropertyPanelGotFocus" LostFocus="OnPropertyPanelLostFocus">
                            <StackPanel>

                                <!-- Format. Les dimensions se saisissent aussi en clair : c'est le
                                     « Create custom page size… » du catalogue de Publisher (fiche
                                     01). Une taille libre ne correspond à aucune entrée du
                                     sélecteur, qui se vide alors sans rien effacer — ce sont les
                                     dimensions qui font foi. Les bornes sont un garde-fou du champ
                                     et non du format : le fichier accepte n'importe quel nombre. -->
                                <ToggleButton Classes="titreSection premiere" IsChecked="{Binding SectionFormatOuverte}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel>
                                            <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                            <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                        </Panel>
                                        <TextBlock Text="Format"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Grid Classes="contenuDeSection" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto"
                                      IsVisible="{Binding SectionFormatOuverte}">
                                    <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" x:Name="FormatDePage" Classes="champ"
                                              ItemsSource="{Binding PageSizes}"
                                              SelectedItem="{Binding SelectedPageSize}"/>
                                    <CheckBox Grid.Row="2" Grid.Column="0" Classes="case" Content="Paysage" IsChecked="{Binding IsLandscape}"/>
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Largeur"/>
                                        <NumericUpDown x:Name="LargeurDePage" Classes="champ"
                                                       TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                       Increment="1" Minimum="10" Maximum="2000"
                                                       Value="{Binding Document.PageWidth, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Hauteur"/>
                                        <NumericUpDown x:Name="HauteurDePage" Classes="champ"
                                                       TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                       Increment="1" Minimum="10" Maximum="2000"
                                                       Value="{Binding Document.PageHeight, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                </Grid>

                                <ToggleButton Classes="titreSection" IsChecked="{Binding SectionMargesOuverte}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel>
                                            <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                            <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                        </Panel>
                                        <TextBlock Text="Marges"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Grid Classes="contenuDeSection" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto"
                                      IsVisible="{Binding SectionMargesOuverte}">
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Gauche"/>
                                        <NumericUpDown x:Name="MargeGauche" Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="1"
                                                       Value="{Binding Document.MarginLeft, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Droite"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="1"
                                                       Value="{Binding Document.MarginRight, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Haut"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="1"
                                                       Value="{Binding Document.MarginTop, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Bas"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="1"
                                                       Value="{Binding Document.MarginBottom, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- La grille de composition : des repères d'aimantation sur la
                                     page, qui ne s'impriment pas. Les lignes de base se règlent en
                                     points, et non en millimètres : elles se calent sur le corps du
                                     texte, qui est typographique. Au plus 24 colonnes et 24 lignes
                                     (« Maximum="24" »), la grille la plus dense que la recette C2
                                     éprouve. -->
                                <ToggleButton Classes="titreSection" IsChecked="{Binding SectionGrilleOuverte}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel>
                                            <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                            <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                        </Panel>
                                        <TextBlock Text="Grille"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Grid Classes="contenuDeSection" ColumnDefinitions="*,8,*" RowDefinitions="Auto,6,Auto,8,Auto,8,Auto"
                                      IsVisible="{Binding SectionGrilleOuverte}">
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Classes="aide"
                                               Text="Les repères de composition ne s'impriment pas ; l'aimantation s'y accroche."/>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Colonnes"/>
                                        <NumericUpDown Classes="champ" FormatString="0" Increment="1" Minimum="1" Maximum="24"
                                                       Value="{Binding Document.ColumnCount}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Gouttière"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                       Increment="1" Minimum="0"
                                                       Value="{Binding Document.ColumnSpacing, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Lignes"/>
                                        <NumericUpDown Classes="champ" FormatString="0" Increment="1" Minimum="1" Maximum="24"
                                                       Value="{Binding Document.RowCount}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Espacement"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}"
                                                       Increment="1" Minimum="0"
                                                       Value="{Binding Document.RowSpacing, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="0">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Ligne de base"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Points}"
                                                       Increment="1" Minimum="0"
                                                       Value="{Binding Document.BaselineSpacing, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="2">
                                        <TextBlock Classes="libelle libelleAuDessus" Text="Décalage"/>
                                        <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.Points}"
                                                       Increment="1" Minimum="0"
                                                       Value="{Binding Document.BaselineOffset, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Les repères de règle. La position exacte se saisit ici : c'est
                                     l'équivalent du dialogue « Format Ruler Guides » de Publisher,
                                     au même endroit que le reste des réglages du document. -->
                                <ToggleButton Classes="titreSection" IsChecked="{Binding SectionReperesOuverte}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel>
                                            <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                            <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                        </Panel>
                                        <TextBlock Text="Repères de règle"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Classes="contenuDeSection" Spacing="6" IsVisible="{Binding SectionReperesOuverte}">
                                    <TextBlock Classes="aide"
                                               Text="Glissez depuis une règle pour en poser un ; ramenez-le hors de la page pour l'enlever."/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Classes="boutonDuDock" Content="Vertical" Command="{Binding AddVerticalRulerGuideCommand}"/>
                                        <Button Classes="boutonDuDock" Content="Horizontal" Command="{Binding AddHorizontalRulerGuideCommand}"/>
                                        <Button Classes="boutonDuDock" Content="Effacer" Command="{Binding ClearRulerGuidesCommand}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Document.VerticalRulerGuides}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:RulerGuide">
                                                <DockPanel Margin="0,2">
                                                    <TextBlock Classes="libelle libelleAGauche" Text="X" Width="12" Margin="0,0,6,0"/>
                                                    <Button DockPanel.Dock="Right" Classes="ib" Width="26" Height="26" Margin="4,0,0,0"
                                                            Content="✕" ToolTip.Tip="Retirer ce repère"
                                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveRulerGuideCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="1"
                                                                   Value="{Binding Position, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Document.HorizontalRulerGuides}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:RulerGuide">
                                                <DockPanel Margin="0,2">
                                                    <TextBlock Classes="libelle libelleAGauche" Text="Y" Width="12" Margin="0,0,6,0"/>
                                                    <Button DockPanel.Dock="Right" Classes="ib" Width="26" Height="26" Margin="4,0,0,0"
                                                            Content="✕" ToolTip.Tip="Retirer ce repère"
                                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveRulerGuideCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <NumericUpDown Classes="champ" TextConverter="{x:Static conv:Unite.MillimetresCourts}" Increment="1"
                                                                   Value="{Binding Position, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Le fond de page, réglé une fois pour toutes les pages, comme
                                     « Format ▸ Background » de Publisher : un fond change l'allure de
                                     la publication entière. Il emprunte les mêmes gabarits que le
                                     fond d'un bloc. -->
                                <ToggleButton Classes="titreSection" IsChecked="{Binding SectionFondDePageOuverte}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel>
                                            <ContentControl Classes="chevronOuvert" Content="{StaticResource IconeSectionOuverte}"/>
                                            <ContentControl Classes="chevronFerme" Content="{StaticResource IconeSectionFermee}"/>
                                        </Panel>
                                        <TextBlock Text="Fond de page"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Classes="contenuDeSection" Spacing="6" IsVisible="{Binding SectionFondDePageOuverte}">
                                    <CheckBox Classes="case" Content="Fond de page" IsChecked="{Binding Document.HasBackground}"/>
                                    <StackPanel IsEnabled="{Binding Document.HasBackground}" Spacing="6">
                                        <DockPanel>
                                            <TextBlock Classes="libelle libelleAGauche" Text="Sorte" Width="52" Margin="0,0,8,0"/>
                                            <ComboBox Classes="champ"
                                                      ItemsSource="{Binding FillKinds}"
                                                      SelectedItem="{Binding Document.BackgroundKind}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static conv:Libelle.Instance}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DockPanel>
                                        <StackPanel IsVisible="{Binding Document.BackgroundIsSolid}">
                                            <views:SelecteurDeCouleur Valeur="{Binding Document.BackgroundColor}"
                                                   Jeu="{Binding #Root.((vm:MainWindowViewModel)DataContext).Document.ColorScheme}"/>
                                        </StackPanel>
                                        <ContentControl Content="{Binding Document.Background}"/>
                                    </StackPanel>
                                    <TextBlock Classes="aide" IsVisible="{Binding !Document.HasBackground}"
                                               Text="Sans fond, la page reste blanche. Le fond ne déborde pas : il s'arrête au format de page."/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
