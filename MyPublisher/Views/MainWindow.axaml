<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyPublisher.ViewModels"
        xmlns:models="using:MyPublisher.Models"
        xmlns:views="using:MyPublisher.Views"
        xmlns:conv="using:MyPublisher.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="MyPublisher.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+G" Command="{Binding GroupSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+H" Command="{Binding UngroupSelectedCommand}"/>
        <!-- Ordre de superposition. Publisher ne donne de raccourci qu'aux deux
             extrêmes (fiche 15) : avancer et reculer d'un rang n'en ont pas, et on
             ne leur en invente pas. Publisher 2007 les posait sur Alt+F6 et
             Alt+Maj+F6 ; ce sont les combinaisons modernes qui sont reprises ici,
             Alt+F6 étant capté par la plupart des gestionnaires de fenêtres Linux —
             un raccourci qui ne peut pas arriver jusqu'à l'application ne sert à rien. -->
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding BringToFrontCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding SendToBackCommand}"/>
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}"/>
        <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ZoomResetCommand}"/>
    </Window.KeyBindings>


    <Window.Resources>
        <!-- Icônes vectorielles de la barre latérale, dessinées dans un carré de 24.
             Le préfixe F0 impose la règle pair-impair : c'est ce qui creuse l'intérieur
             des formes en contour au lieu de les remplir. -->
        <StreamGeometry x:Key="IconSelect">F1 M 6,3 L 6,20 L 10.2,15.9 L 12.9,21.5 L 15.3,20.3 L 12.7,14.9 L 18.5,14.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconText">F1 M 4,4 H 20 V 8.2 H 14.1 V 20 H 9.9 V 8.2 H 4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconHeading">F1 M 4,4 H 8 V 10.4 H 16 V 4 H 20 V 20 H 16 V 13.6 H 8 V 20 H 4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRectangle">F0 M 3,5 H 21 V 19 H 3 Z M 5,7 V 17 H 19 V 7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEllipse">F0 M 3,12 A 9,7 0 1 0 21,12 A 9,7 0 1 0 3,12 Z M 5,12 A 7,5 0 1 1 19,12 A 7,5 0 1 1 5,12 Z</StreamGeometry>
        <!-- Le tableau est dessiné en barres séparées et non en contour évidé : avec la
             règle pair-impair, les croisements des filets se creuseraient en trous
             blancs de un pixel. Toutes les barres tournent dans le même sens, si bien
             que la règle par défaut les additionne au lieu de les soustraire. -->
        <StreamGeometry x:Key="IconTable">F1 M 3,5 H 21 V 6 H 3 Z M 3,18 H 21 V 19 H 3 Z M 3,5 H 4 V 19 H 3 Z M 20,5 H 21 V 19 H 20 Z M 3,9 H 21 V 10 H 3 Z M 9,5 H 10 V 19 H 9 Z M 14,5 H 15 V 19 H 14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconImage">F0 M 3,5 H 21 V 19 H 3 Z M 5,7 V 17 H 19 V 7 Z M 6.4,16 L 10.2,11 L 13,14.2 L 15.6,10.8 L 18.4,16 Z M 7.6,9.6 A 1.4,1.4 0 1 1 10.4,9.6 A 1.4,1.4 0 1 1 7.6,9.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconToFront">F1 M 12,2.5 L 19.5,10 H 4.5 Z M 4.5,12.5 H 19.5 V 15 H 4.5 Z M 4.5,17 H 19.5 V 19.5 H 4.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconForward">F1 M 12,4.5 L 19.5,12 H 4.5 Z M 4.5,15.5 H 19.5 V 19.5 H 4.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconBackward">F1 M 4.5,4.5 H 19.5 V 8.5 H 4.5 Z M 12,19.5 L 4.5,12 H 19.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconToBack">F1 M 4.5,4.5 H 19.5 V 7 H 4.5 Z M 4.5,9 H 19.5 V 11.5 H 4.5 Z M 12,21.5 L 19.5,14 H 4.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCentreH">F1 M 11.4,1.5 H 12.6 V 5 H 11.4 Z M 3,6.5 H 21 V 11 H 3 Z M 7,13 H 17 V 17.5 H 7 Z M 11.4,19 H 12.6 V 22.5 H 11.4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCentreV">F1 M 1.5,11.4 H 5 V 12.6 H 1.5 Z M 6.5,3 H 11 V 21 H 6.5 Z M 13,7 H 17.5 V 17 H 13 Z M 19,11.4 H 22.5 V 12.6 H 19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFitMargins">F0 M 2,4 H 22 V 20 H 2 Z M 4,6 V 18 H 20 V 6 Z M 6.5,8.5 H 17.5 V 15.5 H 6.5 Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="#FF5A6472"/>
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Barre d'outils latérale : boutons carrés à icône. Les outils sont des
             bascules mutuellement exclusives, les actions de simples boutons. -->
        <Style Selector="ToggleButton.sidebar, Button.sidebar">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Échelle 1:1 : toutes les icônes sont dessinées sur une grille de 24, donc
             l'épaisseur de trait reste identique d'un bouton à l'autre. Une mise à
             l'échelle uniforme les normaliserait chacune sur sa propre boîte englobante
             et ferait varier ce trait de 40 %. -->
        <Style Selector="Path.icon">
            <Setter Property="Fill" Value="#FF3A4450"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>
        <Style Selector="ToggleButton.sidebar:checked Path.icon">
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style Selector="Button.sidebar:disabled Path.icon">
            <Setter Property="Fill" Value="#FFAEB5BE"/>
        </Style>
        <Style Selector="Rectangle.sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Fill" Value="#FFD5DAE1"/>
            <Setter Property="Margin" Value="0,9"/>
        </Style>
    </Window.Styles>

    <!-- Les champs de chaque sorte de remplissage, déclarés une fois pour toutes. Le fond
         d'un bloc et le fond de page les partagent : deux copies auraient dérivé, et
         c'est le genre d'écart qui ne se voit qu'en ouvrant les deux panneaux côte à
         côte. L'aplat, lui, se règle par la couleur du porteur — le sélecteur ne peut
         pas être branché sur le remplissage lui-même, il renvoie ce qu'il lit dès qu'il
         s'affiche. -->
    <Window.DataTemplates>

        <!-- L'aplat n'a rien à montrer ici : sa couleur et son opacité se règlent sur le
             porteur, juste au-dessus. Le gabarit existe pour que le sélecteur de sorte
             ne laisse pas voir un nom de classe. -->
        <DataTemplate DataType="models:SolidFill">
            <Panel/>
        </DataTemplate>

        <DataTemplate DataType="models:GradientFill">
            <StackPanel>
                <TextBlock Classes="field" Text="Première couleur" Margin="0,6,0,2"/>
                <ColorPicker HorizontalAlignment="Left"
                             Color="{Binding From, Converter={x:Static conv:HexToColor.Instance}}"/>
                <TextBlock Classes="field" Text="Seconde couleur" Margin="0,6,0,2"/>
                <ColorPicker HorizontalAlignment="Left"
                             Color="{Binding To, Converter={x:Static conv:HexToColor.Instance}}"/>
                <TextBlock Classes="field" Text="Angle (°)" Margin="0,6,0,2"/>
                <!-- Zéro va de gauche à droite, 90 de haut en bas : l'axe Y descend,
                     comme en PDF. Les quatre ombrages de Publisher — horizontal,
                     vertical, deux diagonales — sont 0, 90, 45 et 315. -->
                <NumericUpDown FormatString="0" Increment="15" Minimum="0" Maximum="360"
                               Value="{Binding Angle, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="models:ImageFill">
            <StackPanel>
                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="11"
                           Foreground="#FF8A929E" Margin="0,6,0,0"/>
                <Button Content="Choisir une image…" Margin="0,4,0,0"
                        Click="OnChooseFillImage"/>
                <TextBlock Classes="field" Text="Cadrage" Margin="0,6,0,2"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).ImageFits}"
                          SelectedItem="{Binding Fit}"/>
                <TextBlock Classes="field" Text="Rotation (°)" Margin="0,6,0,2"/>
                <!-- Le quart de tour que Publisher pose sur une image de remplissage :
                     une des cinq d'ATA 21 le porte, et sans lui elle arrive couchée. -->
                <NumericUpDown FormatString="0" Increment="90" Minimum="0" Maximum="270"
                               Value="{Binding Rotation, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="models:TintFill">
            <StackPanel>
                <TextBlock Classes="field" Text="Couleur de base" Margin="0,6,0,2"/>
                <ColorPicker HorizontalAlignment="Left"
                             Color="{Binding Color, Converter={x:Static conv:HexToColor.Instance}}"/>
                <TextBlock Classes="field" Text="Teinte (%)" Margin="0,6,0,2"/>
                <!-- Cent, c'est la couleur de base ; en dessous on va vers le blanc,
                     au-dessus vers le noir. -->
                <NumericUpDown FormatString="0" Increment="10" Minimum="0" Maximum="200"
                               Value="{Binding Percent, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
            </StackPanel>
        </DataTemplate>

    </Window.DataTemplates>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Nouveau…" InputGesture="Ctrl+N" Click="OnNew"/>
                <Separator/>
                <MenuItem Header="_Ouvrir…" InputGesture="Ctrl+O" Click="OnOpen"/>
                <MenuItem Header="_Enregistrer" InputGesture="Ctrl+S" Click="OnSave"/>
                <MenuItem Header="Enregistrer _sous…" Click="OnSaveAs"/>
                <Separator/>
                <MenuItem Header="Exporter en _PDF…" InputGesture="Ctrl+E" Click="OnExportPdf"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="OnQuit"/>
            </MenuItem>

            <MenuItem Header="_Édition">
                <MenuItem Header="_Annuler" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="_Rétablir" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="_Dupliquer" InputGesture="Ctrl+D" Command="{Binding DuplicateSelectedCommand}"/>
                <MenuItem Header="_Supprimer" InputGesture="Delete" Command="{Binding DeleteSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="_Tout sélectionner" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                <Separator/>
                <MenuItem Header="_Informations professionnelles…" Click="OnEditBusinessInfo"/>
            </MenuItem>

            <MenuItem Header="_Insertion">
                <MenuItem Header="_Titre" Command="{Binding AddHeadingCommand}"/>
                <MenuItem Header="Bloc de _texte" Command="{Binding AddTextCommand}"/>
                <MenuItem Header="_Image…" Click="OnInsertImage"/>
                <MenuItem Header="Ta_bleau" Command="{Binding AddTableCommand}"/>
                <Separator/>
                <MenuItem Header="_Rectangle" Command="{Binding AddRectangleCommand}"/>
                <MenuItem Header="_Ellipse" Command="{Binding AddEllipseCommand}"/>
            </MenuItem>

            <MenuItem Header="_Disposition">
                <MenuItem Header="_Grouper" InputGesture="Ctrl+Shift+G"
                          Command="{Binding GroupSelectedCommand}"/>
                <MenuItem Header="_Dissocier" InputGesture="Ctrl+Shift+H"
                          Command="{Binding UngroupSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="Premier _plan" InputGesture="Ctrl+Shift+F"
                          Command="{Binding BringToFrontCommand}"/>
                <MenuItem Header="_Avancer" Command="{Binding BringForwardCommand}"/>
                <MenuItem Header="_Reculer" Command="{Binding SendBackwardCommand}"/>
                <MenuItem Header="Arrière-p_lan" InputGesture="Ctrl+Shift+B"
                          Command="{Binding SendToBackCommand}"/>
                <Separator/>
                <MenuItem Header="Aligner à _gauche" Command="{Binding AlignLeftCommand}"/>
                <MenuItem Header="Centrer _horizontalement" Command="{Binding AlignCentreHorizontallyCommand}"/>
                <MenuItem Header="Aligner à _droite" Command="{Binding AlignRightCommand}"/>
                <MenuItem Header="Aligner en _haut" Command="{Binding AlignTopCommand}"/>
                <MenuItem Header="Centrer _verticalement" Command="{Binding AlignCentreVerticallyCommand}"/>
                <MenuItem Header="Aligner en _bas" Command="{Binding AlignBottomCommand}"/>
                <Separator/>
                <MenuItem Header="Répartir hori_zontalement" Command="{Binding DistributeHorizontallyCommand}"/>
                <MenuItem Header="Répartir vertica_lement" Command="{Binding DistributeVerticallyCommand}"/>
                <Separator/>
                <!-- Le repère de l'alignement, posé une fois pour toutes les commandes
                     ci-dessus : la zone de composition, ou la page — et, page décochée,
                     les blocs entre eux dès qu'ils sont plusieurs. -->
                <MenuItem Header="Par rapport aux mar_ges" ToggleType="CheckBox"
                          IsChecked="{Binding AlignToMargins}"/>
                <Separator/>
                <MenuItem Header="Ajuster aux _marges" Command="{Binding FitToMarginsCommand}"/>
                <Separator/>
                <MenuItem Header="Repères de rè_gle">
                    <MenuItem Header="Ajouter un repère _horizontal" Command="{Binding AddHorizontalRulerGuideCommand}"/>
                    <MenuItem Header="Ajouter un repère _vertical" Command="{Binding AddVerticalRulerGuideCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Effacer tous les repères" Command="{Binding ClearRulerGuidesCommand}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Page">
                <MenuItem Header="_Ajouter une page" Command="{Binding AddPageCommand}"/>
                <MenuItem Header="_Dupliquer la page" Command="{Binding DuplicatePageCommand}"/>
                <MenuItem Header="_Supprimer la page" Command="{Binding DeletePageCommand}"/>
            </MenuItem>

            <MenuItem Header="_Affichage">
                <MenuItem Header="_Repères" ToggleType="CheckBox" IsChecked="{Binding ShowGuides}"/>
                <MenuItem Header="Rè_gles" ToggleType="CheckBox" IsChecked="{Binding ShowRulers}"/>
                <Separator/>
                <MenuItem Header="Zoom _avant" Command="{Binding ZoomInCommand}"/>
                <MenuItem Header="Zoom a_rrière" Command="{Binding ZoomOutCommand}"/>
                <MenuItem Header="Taille _réelle" Command="{Binding ZoomResetCommand}"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#FFF3F4F6" BorderBrush="#FFD9DDE3"
                BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Classes="tool" Content="Nouveau…" Click="OnNew"/>
                <Button Classes="tool" Content="Ouvrir…" Click="OnOpen"/>
                <Button Classes="tool" Content="Enregistrer" Click="OnSave"/>
                <Button Classes="tool" Content="Exporter en PDF" Click="OnExportPdf"/>

                <Rectangle Width="1" Margin="8,2" Fill="#FFD9DDE3"/>

                <Button Classes="tool" Content="Annuler" Command="{Binding UndoCommand}"/>
                <Button Classes="tool" Content="Rétablir" Command="{Binding RedoCommand}"/>

                <Rectangle Width="1" Margin="8,2" Fill="#FFD9DDE3"/>

                <Button Classes="tool" Content="−" Command="{Binding ZoomOutCommand}"/>
                <TextBlock Text="{Binding ZoomLabel}" VerticalAlignment="Center"
                           Width="52" TextAlignment="Center"/>
                <Button Classes="tool" Content="+" Command="{Binding ZoomInCommand}"/>
                <Button Classes="tool" Content="100 %" Command="{Binding ZoomResetCommand}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFF3F4F6" BorderBrush="#FFD9DDE3"
                BorderThickness="0,1,0,0" Padding="10,4">
            <!-- Publisher affiche en permanence la position ET la taille du bloc
                 sélectionné, dans deux cases distinctes (fiche 02) : pendant un
                 redimensionnement, l'œil est sur la page et non sur le panneau de
                 droite. Les cases sont de largeur fixe, comme celle du zoom l'était
                 déjà : elles se rafraîchissent à chaque mouvement du pointeur, et une
                 barre dont les cases se déplacent à chaque chiffre ne se lit plus. -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding CursorLabel}" Margin="16,0"
                           VerticalAlignment="Center" Width="150" TextAlignment="Right"/>
                <TextBlock Grid.Column="2" x:Name="PositionDuBloc" Margin="16,0"
                           VerticalAlignment="Center" Width="150" TextAlignment="Right"
                           Text="{Binding FramePositionLabel}"
                           IsVisible="{Binding HasSelection}"/>
                <!-- Sans marge à gauche : les 16 de la case de position l'en séparent
                     déjà, et les deux se lisent comme un couple. -->
                <TextBlock Grid.Column="3" x:Name="TailleDuBloc" Margin="0"
                           VerticalAlignment="Center" Width="130" TextAlignment="Right"
                           Text="{Binding FrameSizeLabel}"
                           IsVisible="{Binding HasSelection}"/>
                <TextBlock Grid.Column="4" Margin="16,0" VerticalAlignment="Center"
                           Text="{Binding PageCountLabel}"/>
                <TextBlock Grid.Column="5" Margin="16,0" VerticalAlignment="Center"
                           Text="{Binding ZoomLabel}"/>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="210,Auto,*,Auto,300,Auto">

            <!-- Colonne de gauche : pages, puis blocs de la page courante. -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,2*" Background="#FFFAFAFB">
                <TextBlock Grid.Row="0" Classes="section" Text="Pages" Margin="10,8,10,4"/>
                <ListBox Grid.Row="1" Margin="6,0,6,6"
                         ItemsSource="{Binding Document.Pages}"
                         SelectedItem="{Binding CurrentPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Page">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Classes="section" Text="Blocs (du fond vers l'avant)" Margin="10,4"/>

                <!-- La liste montre la pile, et se laisse réordonner en tirant un bloc :
                     c'est le geste qu'on essaie spontanément en la voyant. Le trait
                     d'insertion est posé par-dessus, dans un calque qui ne reçoit pas
                     le pointeur — le geste appartient à la liste. -->
                <Panel Grid.Row="3" Margin="6,0,6,8">
                    <ListBox x:Name="ListeDesBlocs"
                             ItemsSource="{Binding CurrentPage.Frames}"
                             SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Frame">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#FF8A929E"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="TraitDInsertion" Height="2" IsVisible="False"
                                   Fill="#FF2D7DD2"/>
                    </Canvas>
                </Panel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" Background="#FFE3E6EA"/>

            <views:PageCanvas Grid.Column="2" x:Name="PageView"/>

            <GridSplitter Grid.Column="3" Width="4" Background="#FFE3E6EA"/>

            <!-- Colonne de droite : propriétés. Le panneau ouvre une transaction
                 d'annulation dès qu'un champ prend le focus et la ferme au relâchement. -->
            <ScrollViewer Grid.Column="4" Background="#FFFAFAFB"
                          GotFocus="OnPropertyPanelGotFocus" LostFocus="OnPropertyPanelLostFocus">
                <StackPanel Margin="12">

                    <TextBlock Classes="section" Text="DOCUMENT"/>
                    <TextBlock Classes="field" Text="Format"/>
                    <ComboBox x:Name="FormatDePage" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding PageSizes}"
                              SelectedItem="{Binding SelectedPageSize}"/>
                    <CheckBox Content="Paysage" Margin="0,6" IsChecked="{Binding IsLandscape}"/>

                    <!-- Les dimensions se saisissent aussi en clair : c'est le « Create
                         custom page size… » du catalogue de Publisher (fiche 01). Une
                         taille libre ne correspond à aucune entrée du sélecteur
                         ci-dessus, qui se vide alors sans rien effacer — ce sont les
                         dimensions qui font foi, et le sélecteur qui les suit.
                         Les bornes sont un garde-fou du champ et non du format : le
                         fichier accepte n'importe quel nombre, mais une page d'un
                         millimètre n'a pas de sens et une page de trois mètres n'a pas
                         d'imprimante. -->
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Largeur (mm)"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Hauteur (mm)"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="0" x:Name="LargeurDePage"
                                       FormatString="0.#" Increment="1" Minimum="10" Maximum="2000"
                                       Value="{Binding Document.PageWidth, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="2" x:Name="HauteurDePage"
                                       FormatString="0.#" Increment="1" Minimum="10" Maximum="2000"
                                       Value="{Binding Document.PageHeight, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Marge gauche (mm)"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Marge droite (mm)"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="1"
                                       Value="{Binding Document.MarginLeft, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.#" Increment="1"
                                       Value="{Binding Document.MarginRight, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Marge haute (mm)"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="field" Text="Marge basse (mm)"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="0" FormatString="0.#" Increment="1"
                                       Value="{Binding Document.MarginTop, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="2" FormatString="0.#" Increment="1"
                                       Value="{Binding Document.MarginBottom, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                    </Grid>

                    <!-- Le fond de page, réglé une fois pour toutes les pages, comme le
                         fait « Format ▸ Background » de Publisher : un fond change
                         l'allure de la publication entière. Il emprunte les mêmes
                         gabarits que le fond d'un bloc. -->
                    <CheckBox Content="Fond de page" Margin="0,10,0,0"
                              IsChecked="{Binding Document.HasBackground}"/>
                    <StackPanel IsEnabled="{Binding Document.HasBackground}">
                        <TextBlock Classes="field" Text="Sorte de fond" Margin="0,4,0,2"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding FillKinds}"
                                  SelectedItem="{Binding Document.BackgroundKind}"/>
                        <StackPanel IsVisible="{Binding Document.BackgroundIsSolid}">
                            <ColorPicker HorizontalAlignment="Left" Margin="0,6,0,0"
                                         Color="{Binding Document.BackgroundColor, Converter={x:Static conv:HexToColor.Instance}}"/>
                        </StackPanel>
                        <ContentControl Content="{Binding Document.Background}"/>
                    </StackPanel>
                    <TextBlock Text="Sans fond, la page reste blanche. Le fond ne déborde pas : il s'arrête au format de page."
                               IsVisible="{Binding !Document.HasBackground}"
                               FontSize="11" Foreground="#FF8A929E"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock Classes="section" Text="GRILLE"/>
                    <TextBlock Text="Les repères de composition ne s'impriment pas ; l'aimantation s'y accroche."
                               FontSize="11" Foreground="#FF8A929E" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Colonnes"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Gouttière (mm)"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0" Increment="1"
                                       Minimum="1" Maximum="24"
                                       Value="{Binding Document.ColumnCount}"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="0"
                                       Value="{Binding Document.ColumnSpacing, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Lignes"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="field" Text="Espacement (mm)"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="0" FormatString="0" Increment="1"
                                       Minimum="1" Maximum="24"
                                       Value="{Binding Document.RowCount}"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="0"
                                       Value="{Binding Document.RowSpacing, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                    </Grid>

                    <!-- Les lignes de base se règlent en points, et non en millimètres :
                         elles se calent sur le corps du texte, qui est typographique. -->
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Ligne de base (pt)"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Décalage (pt)"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="1" Minimum="0"
                                       Value="{Binding Document.BaselineSpacing, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="0"
                                       Value="{Binding Document.BaselineOffset, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                    </Grid>

                    <TextBlock Classes="section" Text="REPÈRES DE RÈGLE"/>
                    <TextBlock Text="Glissez depuis une règle pour en poser un ; ramenez-le hors de la page pour l'enlever."
                               FontSize="11" Foreground="#FF8A929E" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Vertical" Command="{Binding AddVerticalRulerGuideCommand}" Margin="0,0,4,0"/>
                        <Button Content="Horizontal" Command="{Binding AddHorizontalRulerGuideCommand}" Margin="0,0,4,0"/>
                        <Button Content="Effacer" Command="{Binding ClearRulerGuidesCommand}"/>
                    </StackPanel>

                    <!-- La position exacte se saisit ici : c'est l'équivalent du dialogue
                         « Format Ruler Guides » de Publisher, mais au même endroit que le
                         reste des réglages du document. -->
                    <ItemsControl ItemsSource="{Binding Document.VerticalRulerGuides}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:RulerGuide">
                                <Grid ColumnDefinitions="Auto,6,*,4,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="field" Text="X (mm)" Margin="0"/>
                                    <NumericUpDown Grid.Column="2" FormatString="0.##" Increment="1"
                                                   Value="{Binding Position, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    <Button Grid.Column="4" Content="✕"
                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveRulerGuideCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Document.HorizontalRulerGuides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:RulerGuide">
                                <Grid ColumnDefinitions="Auto,6,*,4,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="field" Text="Y (mm)" Margin="0"/>
                                    <NumericUpDown Grid.Column="2" FormatString="0.##" Increment="1"
                                                   Value="{Binding Position, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                    <Button Grid.Column="4" Content="✕"
                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveRulerGuideCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="section" Text="BLOC"
                               IsVisible="{Binding HasSingleSelection}"/>
                    <TextBlock Text="Aucun bloc sélectionné." Foreground="#FF8A929E" Margin="0,8"
                               IsVisible="{Binding !HasSelection}"/>

                    <!-- À plusieurs blocs, le panneau ne montre aucun champ : éditer les
                         valeurs de l'un d'eux modifierait en silence celui qu'on ne regarde
                         pas. Restent les commandes de disposition, qui, elles, valent pour
                         l'ensemble. -->
                    <StackPanel IsVisible="{Binding HasMultipleSelection}" Margin="0,8">
                        <TextBlock Classes="section" Text="SÉLECTION"/>
                        <TextBlock Text="{Binding SelectionLabel}"/>
                        <TextBlock Text="Alignement, répartition, ordre et déplacement valent pour l'ensemble. Les propriétés s'éditent bloc par bloc."
                                   FontSize="11" Foreground="#FF8A929E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ContentControl Content="{Binding SingleSelected}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="models:Frame">
                                <StackPanel>
                                    <TextBlock Classes="field" Text="Nom"/>
                                    <TextBox Text="{Binding Name}"/>
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="X (mm)"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Y (mm)"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.##" Increment="1"
                                                       Value="{Binding X, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.##" Increment="1"
                                                       Value="{Binding Y, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Largeur (mm)"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="field" Text="Hauteur (mm)"/>
                                        <NumericUpDown Grid.Row="3" Grid.Column="0" FormatString="0.##" Increment="1" Minimum="2"
                                                       Value="{Binding Width, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                        <NumericUpDown Grid.Row="3" Grid.Column="2" FormatString="0.##" Increment="1" Minimum="2"
                                                       Value="{Binding Height, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Rotation (°)"/>
                                        <NumericUpDown Grid.Row="5" Grid.Column="0" FormatString="0.#" Increment="1"
                                                       Minimum="-360" Maximum="360"
                                                       Value="{Binding Rotation, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>

                    <!-- Propriétés propres au type de bloc. -->
                    <ContentControl Content="{Binding SingleSelected}">
                        <ContentControl.DataTemplates>

                            <DataTemplate DataType="models:TextFrame">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="TEXTE"/>

                                    <TextBlock Classes="field" Text="Contenu"/>
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).TextFieldOptions}"
                                              SelectedValue="{Binding Field}"
                                              SelectedValueBinding="{Binding Kind}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="models:FieldOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Le texte saisi reste là sous le champ, et se retrouve
                                         intact quand on repasse à « Aucun ». -->
                                    <TextBox Text="{Binding Saisie}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="110" VerticalContentAlignment="Top" Margin="0,4,0,0"
                                             IsEnabled="{Binding !HasField}"/>
                                    <TextBlock Text="Le contenu est calculé à l'affichage et à l'export ; il ne se saisit pas sur la page."
                                               IsVisible="{Binding HasField}"
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Classes="field" Text="Police" Margin="0,8,0,2"/>
                                    <ComboBox HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                                              ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).FontFamilies}"
                                              SelectedItem="{Binding FontFamily}"/>

                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Corps (pt)"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Interligne"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="0.5" Minimum="1"
                                                       Value="{Binding FontSize, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.00" Increment="0.05" Minimum="0.5"
                                                       Value="{Binding LineHeight, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <ToggleButton Content="G" FontWeight="Bold" Width="36" IsChecked="{Binding Bold}"/>
                                        <ToggleButton Content="I" FontStyle="Italic" Width="36" Margin="4,0"
                                                      IsChecked="{Binding Italic}"/>
                                    </StackPanel>

                                    <!-- Deux alignements et non un : l'horizontal cale les
                                         lignes dans leur largeur, le vertical cale le
                                         texte entier dans la hauteur du bloc. Publisher
                                         les présente aussi séparément, le second sous
                                         « Format Text Box ▸ Vertical alignment ». -->
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Alignement"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Vertical"/>
                                        <ComboBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).TextAlignments}"
                                                  SelectedItem="{Binding Align}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).VerticalAlignments}"
                                                  SelectedItem="{Binding VerticalAlign}"/>
                                    </Grid>

                                    <TextBlock Classes="field" Text="Marges intérieures (pt)" Margin="0,8,0,2"/>
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Gauche"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Droite"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="1" Minimum="0"
                                                       Value="{Binding PaddingLeft, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="0"
                                                       Value="{Binding PaddingRight, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Haute"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="field" Text="Basse"/>
                                        <NumericUpDown Grid.Row="3" Grid.Column="0" FormatString="0.#" Increment="1" Minimum="0"
                                                       Value="{Binding PaddingTop, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <NumericUpDown Grid.Row="3" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="0"
                                                       Value="{Binding PaddingBottom, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>

                                    <!-- Les colonnes du BLOC, où le texte coule de l'une à
                                         l'autre — à ne pas confondre avec celles du
                                         document, plus bas dans le panneau DOCUMENT, qui
                                         sont des repères d'aimantation posés sur la page.
                                         Deux fonctions différentes sous le même mot. -->
                                    <TextBlock Classes="field" Text="Colonnes du bloc" Margin="0,8,0,2"/>
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Nombre"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Gouttière (pt)"/>
                                        <!-- Minimum à un : zéro ou moins ne veut rien dire, et
                                             la composition qui s'en défend le ferait alors en
                                             silence. Le maximum est un garde-fou du panneau et
                                             non du format — au-delà, les colonnes sont plus
                                             étroites qu'un mot. -->
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" x:Name="NombreDeColonnes"
                                                       FormatString="0" Increment="1" Minimum="1" Maximum="20"
                                                       Value="{Binding Columns}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.##" Increment="1" Minimum="0"
                                                       Value="{Binding ColumnGap, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>
                                    <TextBlock Text="Le texte remplit la première colonne jusqu'au bas du bloc, puis passe à la suivante."
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <!-- Retraits et espacement valent pour tout le bloc. Les
                                         écarts paragraphe par paragraphe se lisent et
                                         s'écrivent dans le fichier, mais ne se règlent pas
                                         encore ici : ce serait un geste sur le texte, pas
                                         sur le bloc, et il n'y a pas de sélection de texte. -->
                                    <TextBlock Classes="field" Text="Retraits (pt)" Margin="0,8,0,2"/>
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Gauche"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Droite"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="1" Minimum="-1000"
                                                       Value="{Binding IndentLeft, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="-1000"
                                                       Value="{Binding IndentRight, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Première ligne"/>
                                        <!-- Minimum négatif, et ce n'est pas un détail : le
                                             retrait de première ligne négatif est la seule
                                             façon de composer une liste à puces, et un
                                             minimum à zéro le rendrait inatteignable au
                                             panneau tout en marchant dans le fichier. -->
                                        <NumericUpDown Grid.Row="3" Grid.Column="0" x:Name="RetraitPremiereLigne"
                                                       FormatString="0.#" Increment="1" Minimum="-1000"
                                                       Value="{Binding IndentFirstLine, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>
                                    <TextBlock Text="Un retrait de première ligne négatif la fait pendre à gauche des suivantes : c'est ainsi qu'on aligne une liste à puces."
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Classes="field" Text="Espacement des paragraphes (pt)" Margin="0,8,0,2"/>
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Avant"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Après"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="1" Minimum="0"
                                                       Value="{Binding SpaceBefore, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.#" Increment="1" Minimum="0"
                                                       Value="{Binding SpaceAfter, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>

                                    <TextBlock Classes="field" Text="Couleur" Margin="0,8,0,2"/>
                                    <ColorPicker HorizontalAlignment="Left"
                                                 Color="{Binding Foreground, Converter={x:Static conv:HexToColor.Instance}}"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Rien de propre à la forme : tout ce qu'elle avait — fond,
                                 contour, épaisseur, arrondi — est commun à tous les blocs et
                                 se règle plus bas. Le gabarit vide évite que le contrôle
                                 n'affiche le nom du type faute de gabarit. -->
                            <DataTemplate DataType="models:ShapeFrame">
                                <Panel/>
                            </DataTemplate>

                            <DataTemplate DataType="models:GroupFrame">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="GROUPE"/>
                                    <TextBlock Text="{Binding Children.Count, StringFormat='{}{0} blocs réunis'}"/>
                                    <TextBlock Text="Le groupe se déplace, se tourne et se redimensionne d'une pièce ; le redimensionner met ses blocs à la même échelle. Pour en retoucher un, dissociez (Ctrl+Maj+H)."
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="models:TableFrame">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="TABLEAU"/>
                                    <TextBlock Text="Les colonnes et les lignes font la taille du bloc : les élargir l'élargit, le redimensionner les mesure à la même aune."
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Lignes"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Colonnes"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0" Increment="1"
                                                       Minimum="1" Maximum="40" Value="{Binding RowCount}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0" Increment="1"
                                                       Minimum="1" Maximum="40" Value="{Binding ColumnCount}"/>
                                    </Grid>

                                    <TextBlock Classes="field" Text="Police" Margin="0,8,0,2"/>
                                    <ComboBox HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                                              ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).FontFamilies}"
                                              SelectedItem="{Binding FontFamily}"/>

                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Corps (pt)"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Interligne"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="0.5" Minimum="1"
                                                       Value="{Binding FontSize, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="2" FormatString="0.00" Increment="0.05" Minimum="0.5"
                                                       Value="{Binding LineHeight, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <ToggleButton Content="G" FontWeight="Bold" Width="36" IsChecked="{Binding Bold}"/>
                                        <ToggleButton Content="I" FontStyle="Italic" Width="36" Margin="4,0"
                                                      IsChecked="{Binding Italic}"/>
                                    </StackPanel>

                                    <TextBlock Classes="field" Text="Marge intérieure des cases (pt)"/>
                                    <NumericUpDown FormatString="0.#" Increment="1" Minimum="0"
                                                   Value="{Binding CellPadding, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>

                                    <TextBlock Classes="field" Text="Couleur du texte" Margin="0,8,0,2"/>
                                    <ColorPicker HorizontalAlignment="Left"
                                                 Color="{Binding Foreground, Converter={x:Static conv:HexToColor.Instance}}"/>

                                    <!-- La grille se règle pour toutes les cases à la fois ; chacune
                                         garde pourtant son contour dans le fichier, comme Publisher
                                         les décrit. Personne ne veut cocher trois cases pour
                                         encadrer une bande. -->
                                    <CheckBox Content="Encadrer les cases" Margin="0,10,0,0"
                                              IsChecked="{Binding HasGrid}"/>
                                    <StackPanel IsEnabled="{Binding HasGrid}">
                                        <ColorPicker HorizontalAlignment="Left" Margin="0,2,0,0"
                                                     Color="{Binding GridColor, Converter={x:Static conv:HexToColor.Instance}}"/>
                                        <TextBlock Classes="field" Text="Épaisseur des filets (pt)" Margin="0,6,0,2"/>
                                        <NumericUpDown FormatString="0.#" Increment="0.5" Minimum="0"
                                                       Value="{Binding GridThickness, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                    </StackPanel>

                                    <TextBlock Classes="field" Text="Largeur des colonnes (mm)" Margin="0,10,0,2"/>
                                    <ItemsControl ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:TableColumn">
                                                <NumericUpDown FormatString="0.##" Increment="1" Minimum="1"
                                                               Value="{Binding Width, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Classes="field" Text="Hauteur des lignes (mm)" Margin="0,8,0,2"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:TableRow">
                                                <NumericUpDown FormatString="0.##" Increment="1" Minimum="1"
                                                               Value="{Binding Height, Converter={x:Static conv:PointsToMillimetres.Instance}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Les cases se règlent ici et non sur la page : il n'y a pas
                                         de sélection à l'intérieur d'un bloc, et une bande en
                                         compte trois. Chacune est nommée par son rang, ligne puis
                                         colonne, pour qu'on sache laquelle on modifie. -->
                                    <TextBlock Classes="section" Text="CASES"/>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:TableCell">
                                                <Border BorderBrush="#FFE3E6EA" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                                   Foreground="#FF8A929E"/>
                                                        <TextBox Classes="cellText"
                                                                 Text="{Binding Saisie}" AcceptsReturn="True"
                                                                 TextWrapping="Wrap" Height="54"
                                                                 VerticalContentAlignment="Top" Margin="0,2,0,0"/>
                                                        <Grid ColumnDefinitions="*,8,Auto" Margin="0,4,0,0">
                                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                                      ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).TextAlignments}"
                                                                      SelectedItem="{Binding Align}"/>
                                                            <CheckBox Grid.Column="2" Content="Fond"
                                                                      IsChecked="{Binding HasFill}"/>
                                                        </Grid>
                                                        <ColorPicker HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                     IsEnabled="{Binding HasFill}"
                                                                     Color="{Binding FillColor, Converter={x:Static conv:HexToColor.Instance}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="models:ImageFrame">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="IMAGE"/>
                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="#FF8A929E"
                                               IsVisible="{Binding !HasField}"/>

                                    <TextBlock Classes="field" Text="Source" Margin="0,8,0,2"/>
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).ImageFieldOptions}"
                                              SelectedValue="{Binding Field}"
                                              SelectedValueBinding="{Binding Kind}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="models:FieldOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="L'image vient du jeu de coordonnées : elle change avec lui, et suit celui qui ouvre le document."
                                               IsVisible="{Binding HasField}"
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Classes="field" Text="Cadrage" Margin="0,8,0,2"/>
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).ImageFits}"
                                              SelectedItem="{Binding Fit}"/>
                                </StackPanel>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>

                    <!-- Fond et contour, communs à tous les blocs. En dernier, après ce
                         qui est propre au type : d'abord ce qu'est le bloc, ensuite
                         comment il est habillé. -->
                    <ContentControl Content="{Binding SingleSelected}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="models:Frame">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="FOND ET CONTOUR"/>

                                    <CheckBox Content="Appliquer un fond" IsChecked="{Binding HasFill}"/>
                                    <StackPanel IsEnabled="{Binding HasFill}">
                                        <TextBlock Classes="field" Text="Sorte de fond" Margin="0,4,0,2"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).FillKinds}"
                                                  SelectedItem="{Binding FillKind}"/>
                                        <!-- L'aplat se règle ici et non dans le gabarit du
                                             remplissage : le sélecteur de couleur renvoie ce
                                             qu'il lit dès qu'il s'affiche, et il ne doit
                                             écrire que si le fond est bien un aplat. -->
                                        <StackPanel IsVisible="{Binding FillIsSolid}">
                                            <ColorPicker HorizontalAlignment="Left" Margin="0,6,0,0"
                                                         Color="{Binding FillColor, Converter={x:Static conv:HexToColor.Instance}}"/>
                                            <TextBlock Classes="field" Text="Opacité du fond (%)" Margin="0,6,0,2"/>
                                            <NumericUpDown FormatString="0" Increment="5" Minimum="0" Maximum="100"
                                                           Value="{Binding FillOpacity, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                        </StackPanel>
                                        <!-- Le dégradé, l'image et la teinte, par les gabarits
                                             que le fond de page partage. -->
                                        <ContentControl Content="{Binding Fill}"/>
                                    </StackPanel>
                                    <TextBlock Text="Sans fond, ce qui passe sous le bloc reste visible."
                                               IsVisible="{Binding !HasFill}"
                                               FontSize="11" Foreground="#FF8A929E"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <CheckBox Content="Appliquer un contour" Margin="0,10,0,0" IsChecked="{Binding HasStroke}"/>
                                    <StackPanel IsEnabled="{Binding HasStroke}">
                                        <ColorPicker HorizontalAlignment="Left" Margin="0,2,0,0"
                                                     Color="{Binding StrokeColor, Converter={x:Static conv:HexToColor.Instance}}"/>
                                        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Épaisseur (pt)"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Trait"/>
                                            <NumericUpDown Grid.Row="1" Grid.Column="0" FormatString="0.#" Increment="0.5" Minimum="0"
                                                           Value="{Binding StrokeThickness, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).StrokeStyles}"
                                                      SelectedItem="{Binding StrokeStyle}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Classes="field" Text="Arrondi des angles (pt)" Margin="0,10,0,2"/>
                                    <NumericUpDown FormatString="0.#" Increment="1" Minimum="0"
                                                   Value="{Binding CornerRadius, Converter={x:Static conv:DoubleToDecimal.Instance}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Barre d'outils latérale. Les six premiers boutons arment un outil :
                 on trace ensuite le bloc directement sur la page. Les suivants sont
                 des actions immédiates sur le bloc sélectionné. -->
            <Border Grid.Column="5" Background="#FFF3F4F6"
                    BorderBrush="#FFD9DDE3" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="9,10" HorizontalAlignment="Center">

                        <ToggleButton Classes="sidebar" ToolTip.Tip="Sélection (V)"
                                      IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Select}">
                            <Path Classes="icon" Data="{StaticResource IconSelect}"/>
                        </ToggleButton>
                        <ToggleButton Classes="sidebar" ToolTip.Tip="Bloc de texte (T)"
                                      IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Text}">
                            <Path Classes="icon" Data="{StaticResource IconText}"/>
                        </ToggleButton>
                        <ToggleButton Classes="sidebar" ToolTip.Tip="Titre (H)"
                                      IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Heading}">
                            <Path Classes="icon" Data="{StaticResource IconHeading}"/>
                        </ToggleButton>
                        <ToggleButton Classes="sidebar" ToolTip.Tip="Rectangle (R)"
                                      IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Rectangle}">
                            <Path Classes="icon" Data="{StaticResource IconRectangle}"/>
                        </ToggleButton>
                        <ToggleButton Classes="sidebar" ToolTip.Tip="Ellipse (E)"
                                      IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Ellipse}">
                            <Path Classes="icon" Data="{StaticResource IconEllipse}"/>
                        </ToggleButton>

                        <!-- « B » comme bande : « T » appartient au texte, et ces
                             tableaux-là sont des bandes à trois cases. -->
                        <ToggleButton Classes="sidebar" ToolTip.Tip="Tableau (B)"
                                      IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumToBool.Instance}, ConverterParameter=Table}">
                            <Path Classes="icon" Data="{StaticResource IconTable}"/>
                        </ToggleButton>

                        <!-- L'image ne se trace pas : elle demande d'abord un fichier. -->
                        <Button Classes="sidebar" ToolTip.Tip="Insérer une image…" Click="OnInsertImage">
                            <Path Classes="icon" Data="{StaticResource IconImage}"/>
                        </Button>

                        <Rectangle Classes="sep"/>

                        <Button Classes="sidebar" ToolTip.Tip="Premier plan"
                                Command="{Binding BringToFrontCommand}">
                            <Path Classes="icon" Data="{StaticResource IconToFront}"/>
                        </Button>
                        <Button Classes="sidebar" ToolTip.Tip="Avancer d'un rang"
                                Command="{Binding BringForwardCommand}">
                            <Path Classes="icon" Data="{StaticResource IconForward}"/>
                        </Button>
                        <Button Classes="sidebar" ToolTip.Tip="Reculer d'un rang"
                                Command="{Binding SendBackwardCommand}">
                            <Path Classes="icon" Data="{StaticResource IconBackward}"/>
                        </Button>
                        <Button Classes="sidebar" ToolTip.Tip="Arrière-plan"
                                Command="{Binding SendToBackCommand}">
                            <Path Classes="icon" Data="{StaticResource IconToBack}"/>
                        </Button>

                        <Rectangle Classes="sep"/>

                        <Button Classes="sidebar" ToolTip.Tip="Centrer horizontalement"
                                Command="{Binding AlignCentreHorizontallyCommand}">
                            <Path Classes="icon" Data="{StaticResource IconCentreH}"/>
                        </Button>
                        <Button Classes="sidebar" ToolTip.Tip="Centrer verticalement"
                                Command="{Binding AlignCentreVerticallyCommand}">
                            <Path Classes="icon" Data="{StaticResource IconCentreV}"/>
                        </Button>
                        <Button Classes="sidebar" ToolTip.Tip="Ajuster aux marges"
                                Command="{Binding FitToMarginsCommand}">
                            <Path Classes="icon" Data="{StaticResource IconFitMargins}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
