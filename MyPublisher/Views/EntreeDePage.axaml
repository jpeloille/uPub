<!--
    Une entrée du panneau Pages (phase I). Un contrôle à part, dans son propre fichier :
    c'est le point d'accroche des vignettes du poste I5, qui le remplit sans toucher à
    MainWindow.axaml.

    D'ici là, le numéro de la page, comme la maquette l'écrit sous sa vignette : corps 11,
    au gris de la barre d'état, et en demi-gras à l'accent pour la page courante — la liste
    le dit par sa sélection, que l'entrée lit sur son conteneur.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MyPublisher.Models"
             xmlns:conv="using:MyPublisher.Converters"
             x:Class="MyPublisher.Views.EntreeDePage"
             x:DataType="models:Page">

    <UserControl.Styles>
        <Style Selector="TextBlock.numeroDePage">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Etat}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.numeroDePage">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentSurvol}"/>
        </Style>
    </UserControl.Styles>

    <!-- Le numéro est le rang de la page dans la liste, et non son nom : un .pub importé
         nomme ses pages comme il veut. Le nombre d'entrées est lié lui aussi, pour que les
         numéros suivent une page insérée ou retirée avant celle-ci. -->
    <TextBlock x:Name="NumeroDePage" Classes="numeroDePage">
        <TextBlock.Text>
            <MultiBinding Converter="{x:Static conv:NumeroDePage.Instance}">
                <Binding/>
                <Binding Path="$parent[ListBox].ItemsSource"/>
                <Binding Path="$parent[ListBox].ItemCount"/>
            </MultiBinding>
        </TextBlock.Text>
    </TextBlock>
</UserControl>
