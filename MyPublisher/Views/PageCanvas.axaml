<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPublisher.ViewModels"
             xmlns:models="using:MyPublisher.Models"
             xmlns:conv="using:MyPublisher.Converters"
             xmlns:views="using:MyPublisher.Views"
             x:Class="MyPublisher.Views.PageCanvas"
             x:Name="Board"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True">

    <UserControl.Styles>
        <!-- Le thème repeint le fond du champ de saisie au survol et pendant la frappe, et
             il le fait sur l'élément de gabarit, pas sur le contrôle : le fond transparent
             posé sur le TextBox est donc perdu dès qu'on entre dans le bloc. On le rétablit
             pour chacun de ces états. Un fond blanc n'est pas un fond transparent : ce qui
             passe sous le bloc doit rester visible pendant la saisie comme en dehors. -->
        <Style Selector="TextBox.frameEditor /template/ Border#PART_BorderElement, TextBox.frameEditor:pointerover /template/ Border#PART_BorderElement, TextBox.frameEditor:focus /template/ Border#PART_BorderElement, TextBox.frameEditor:focus-within /template/ Border#PART_BorderElement">
            <!-- « Transparent » et non « nul » : un fond nul ne reçoit pas le clic,
                 et on ne pourrait plus poser le curseur dans le texte. -->
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ItemsControl place ses éléments via un ContentPresenter : c'est lui qui porte
             la position sur le Canvas. Le style est posé ici, et non sur un ItemsControl
             précis, pour valoir aussi bien pour les blocs de la page que pour ceux d'un
             groupe — le rendu est récursif. -->
        <Style Selector="ItemsControl.frames ContentPresenter" x:DataType="models:Frame">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        </Style>

        <!-- Même mécanique pour les repères : c'est le ContentPresenter qui porte la
             position, une abscisse pour les verticaux, une ordonnée pour les autres. -->
        <Style Selector="ItemsControl.verticalGuides ContentPresenter" x:DataType="models:GuideLine">
            <Setter Property="Canvas.Left" Value="{Binding Position}"/>
        </Style>
        <Style Selector="ItemsControl.horizontalGuides ContentPresenter" x:DataType="models:GuideLine">
            <Setter Property="Canvas.Top" Value="{Binding Position}"/>
        </Style>
        <Style Selector="ItemsControl.verticalRulerGuides ContentPresenter" x:DataType="models:RulerGuide">
            <Setter Property="Canvas.Left" Value="{Binding Position}"/>
        </Style>
        <Style Selector="ItemsControl.horizontalRulerGuides ContentPresenter" x:DataType="models:RulerGuide">
            <Setter Property="Canvas.Top" Value="{Binding Position}"/>
        </Style>

        <!-- Fond et contour d'un bloc : deux éléments qui prennent le contenu en
             sandwich, le fond dessous, le contour dessus — un filet posé sur une image
             passe sur son bord et non sous elle, et l'export trace dans le même ordre.
             Les liaisons sont posées ici une fois pour toutes ; chaque gabarit n'a plus
             qu'à poser un élément de la classe voulue. Aucun des deux ne reçoit le
             pointeur : la couche de saisie s'en charge, et pendant la frappe le contour
             ne doit pas voler le clic au champ de texte.

             Le fond est dessiné par un contrôle et non peint par un pinceau, depuis que
             les remplissages ne sont plus tous unis : une image que Publisher fait
             pivoter dans son cadre ne se dit pas en pinceau. Le même contrôle sert au
             fond de page, ce qui garantit qu'un dégradé de page et un dégradé de bloc se
             rendent pareil. -->
        <Style Selector="views|FondBloc.frameFill" x:DataType="models:Frame">
            <Setter Property="Fond" Value="{Binding Fill}"/>
            <Setter Property="Arrondi" Value="{Binding CornerRadius}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- Le filet est CENTRÉ sur le bord, comme à l'export : un Rectangle rentre son
             trait dans ses limites, on l'élargit donc d'une demi-épaisseur (poste Q4).
             Sans arrondi de mise en page : sous la mise à l'échelle, Avalonia arrondirait
             cette marge au point entier, en arrondi bancaire — un filet de 1 pt resterait
             décalé d'un demi-point, un de 3 pt aussi (relecture du 12 octobre 2026).
             Sa couleur passe par la charte héritée de la page : un contour pris dans le
             jeu de couleurs suit le jeu (poste C5b). -->
        <Style Selector="Rectangle.frameStroke" x:DataType="models:Frame">
            <Setter Property="Margin" Value="{Binding StrokeThickness, Converter={x:Static conv:Conv.FiletCentre}}"/>
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="Stroke">
                <MultiBinding Converter="{x:Static conv:CouleurDuJeu.Pinceau}">
                    <Binding Path="Stroke"/>
                    <Binding Path="$self.(views:JeuAffiche.Charte)"/>
                </MultiBinding>
            </Setter>
            <Setter Property="StrokeThickness" Value="{Binding StrokeThickness}"/>
            <Setter Property="StrokeDashArray" Value="{Binding StrokeStyle, Converter={x:Static conv:Conv.Dash}}"/>
            <Setter Property="RadiusX" Value="{Binding CornerRadius}"/>
            <Setter Property="RadiusY" Value="{Binding CornerRadius}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <!-- Gabarits des blocs, posés au niveau du contrôle : le canevas d'un groupe les
         retrouve par la même recherche, ce qui rend le rendu récursif sans duplication. -->
    <UserControl.DataTemplates>

        <DataTemplate DataType="models:ShapeFrame">
            <Panel Width="{Binding Width}" Height="{Binding Height}"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="{Binding Rotation, Converter={x:Static conv:Conv.Rotate}}">
                <!-- Une forme n'a pas de contenu, mais elle passe par le même fond et le
                     même contour que les autres blocs depuis C5c : elle peut porter un
                     dégradé ou une image, qu'un « Fill » de rectangle ne saurait pas
                     poser. C'est aussi l'ordre de l'export, qui a cessé pour cela de
                     tracer la forme d'un seul trait. -->
                <views:FondBloc Classes="frameFill" Ellipse="{Binding IsEllipse}"/>
                <!-- Centrés sur le bord, comme le filet de tout bloc (poste Q4), et pour la
                     même raison sans arrondi de mise en page. -->
                <Rectangle IsVisible="{Binding IsRectangle}"
                           Margin="{Binding StrokeThickness, Converter={x:Static conv:Conv.FiletCentre}}"
                           UseLayoutRounding="False"
                           StrokeThickness="{Binding StrokeThickness}"
                           StrokeDashArray="{Binding StrokeStyle, Converter={x:Static conv:Conv.Dash}}"
                           RadiusX="{Binding CornerRadius}"
                           RadiusY="{Binding CornerRadius}">
                    <Rectangle.Stroke>
                        <MultiBinding Converter="{x:Static conv:CouleurDuJeu.Pinceau}">
                            <Binding Path="Stroke"/>
                            <Binding Path="$self.(views:JeuAffiche.Charte)"/>
                        </MultiBinding>
                    </Rectangle.Stroke>
                </Rectangle>
                <Ellipse IsVisible="{Binding IsEllipse}"
                         Margin="{Binding StrokeThickness, Converter={x:Static conv:Conv.FiletCentre}}"
                         UseLayoutRounding="False"
                         StrokeThickness="{Binding StrokeThickness}"
                         StrokeDashArray="{Binding StrokeStyle, Converter={x:Static conv:Conv.Dash}}">
                    <Ellipse.Stroke>
                        <MultiBinding Converter="{x:Static conv:CouleurDuJeu.Pinceau}">
                            <Binding Path="Stroke"/>
                            <Binding Path="$self.(views:JeuAffiche.Charte)"/>
                        </MultiBinding>
                    </Ellipse.Stroke>
                </Ellipse>
            </Panel>
        </DataTemplate>

        <DataTemplate DataType="models:ImageFrame">
            <Panel Width="{Binding Width}" Height="{Binding Height}"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="{Binding Rotation, Converter={x:Static conv:Conv.Rotate}}">
                <views:FondBloc Classes="frameFill"/>
                <!-- Repère visible tant qu'aucune image n'est chargée, et seulement si les
                     repères le sont : il ne s'imprime pas. Jusqu'au poste Q16, il était
                     toujours dessiné — une image cadrée sans déformation le laissait voir
                     sur le bord du bloc, et il entrait dans toute comparaison au PDF. -->
                <Rectangle Classes="emplacementImage"
                           Stroke="#FFB0B0B0" StrokeThickness="0.5" StrokeDashArray="4,3">
                    <Rectangle.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="#Board.((vm:MainWindowViewModel)DataContext).ShowGuides"/>
                            <Binding Path="#Photo.Source" Converter="{x:Static ObjectConverters.IsNull}"/>
                        </MultiBinding>
                    </Rectangle.IsVisible>
                </Rectangle>
                <!-- Même découpage que pour le texte : le chemin passe par le résolveur,
                     ce qui permet à un bloc de porter le logo du jeu de coordonnées. -->
                <Image x:Name="Photo" Stretch="{Binding Fit, Converter={x:Static conv:Conv.Fit}}">
                    <Image.Source>
                        <MultiBinding Converter="{x:Static conv:FieldToImage.Instance}">
                            <Binding Path="Path"/>
                            <Binding Path="Field"/>
                            <Binding Path="#Board.((vm:MainWindowViewModel)DataContext).FieldContext"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <Rectangle Classes="frameStroke"/>
            </Panel>
        </DataTemplate>

        <DataTemplate DataType="models:TextFrame">
            <Panel Width="{Binding Width}" Height="{Binding Height}"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="{Binding Rotation, Converter={x:Static conv:Conv.Rotate}}">
                <!-- Le fond est un rectangle sous les deux contrôles, pas une propriété
                     de l'un d'eux : il reste donc identique à l'affichage et pendant la
                     saisie, le TextBox se contentant d'être transparent. -->
                <views:FondBloc Classes="frameFill"/>
                <!-- Seul le texte est découpé au bloc. Le contour, lui, est centré sur le
                     bord et déborde de moitié, comme à l'export : le découper le
                     réduirait à l'écran à la moitié de son épaisseur. -->
                <Panel ClipToBounds="True">
                    <!-- Affichage et saisie sont deux contrôles distincts : le TextBlock
                         donne le contrôle typographique, le TextBox l'édition et le caret. -->
                    <!-- Le texte affiché passe par le résolveur de champs : littéral tant
                         qu'aucun champ n'est posé, calculé sinon. Le contexte vient du
                         contrôle et non du bloc — un bloc ignore sur quelle page il est,
                         et c'est très bien ainsi. -->
                    <views:TexteCompose IsVisible="{Binding !IsEditing}"
                                        Bloc="{Binding}">
                        <!-- Le contenu passe par le résolveur de champs ; la composition,
                             elle, est celle du noyau — la même fonction que l'export
                             appelle, donc les mêmes lignes, par construction. -->
                        <views:TexteCompose.Contenu>
                            <MultiBinding Converter="{x:Static conv:FieldToText.Instance}">
                                <Binding Path="Text"/>
                                <Binding Path="Field"/>
                                <Binding Path="#Board.((vm:MainWindowViewModel)DataContext).FieldContext"/>
                            </MultiBinding>
                        </views:TexteCompose.Contenu>
                    </views:TexteCompose>
                    <!-- Liée à « Saisie » et non à « Text » : c'est la saisie qui recale
                         les fragments de style et les écarts de paragraphe sur le texte
                         tapé (poste Q1). Liée à « Text », la frappe ferait glisser les
                         gras d'un bloc importé sans que rien ne le dise. -->
                    <!-- Police et couleur passent par la charte héritée de la page : un texte
                         pris dans le jeu se saisit dans la police du jeu (poste C5b). -->
                    <TextBox IsVisible="{Binding IsEditing}"
                             Text="{Binding Saisie, Mode=TwoWay}"
                             FontSize="{Binding FontSize}"
                             FontWeight="{Binding Bold, Converter={x:Static conv:Conv.Weight}}"
                             FontStyle="{Binding Italic, Converter={x:Static conv:Conv.Slant}}"
                             TextAlignment="{Binding Align, Converter={x:Static conv:Conv.Align}}"
                             Padding="{Binding Padding, Converter={x:Static conv:Conv.Pad}}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Classes="frameEditor"
                             Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Top">
                        <TextBox.FontFamily>
                            <MultiBinding Converter="{x:Static conv:PoliceDuJeu.Instance}">
                                <Binding Path="FontFamily"/>
                                <Binding Path="$self.(views:JeuAffiche.Charte)"/>
                            </MultiBinding>
                        </TextBox.FontFamily>
                        <TextBox.Foreground>
                            <MultiBinding Converter="{x:Static conv:CouleurDuJeu.Pinceau}">
                                <Binding Path="Foreground"/>
                                <Binding Path="$self.(views:JeuAffiche.Charte)"/>
                            </MultiBinding>
                        </TextBox.Foreground>
                    </TextBox>
                </Panel>
                <!-- Le marqueur de débordement est HORS du panneau découpé : il doit
                     mordre le bord du bloc, ce que le découpage lui interdirait. Il ne
                     s'imprime pas, et se range donc sous le même interrupteur que les
                     repères — c'est aussi ce qui permet de comparer l'écran au PDF sur
                     une page qui déborde. -->
                <views:MarqueurDebordement
                    IsHitTestVisible="False"
                    IsVisible="{Binding #Board.((vm:MainWindowViewModel)DataContext).ShowGuides}"
                    Bloc="{Binding}">
                    <views:MarqueurDebordement.Contenu>
                        <MultiBinding Converter="{x:Static conv:FieldToText.Instance}">
                            <Binding Path="Text"/>
                            <Binding Path="Field"/>
                            <Binding Path="#Board.((vm:MainWindowViewModel)DataContext).FieldContext"/>
                        </MultiBinding>
                    </views:MarqueurDebordement.Contenu>
                </views:MarqueurDebordement>
                <Rectangle Classes="frameStroke"/>
            </Panel>
        </DataTemplate>

        <DataTemplate DataType="models:GroupFrame">
            <!-- Un groupe n'a pas d'apparence propre : il pose son repère, et ses blocs
                 se dessinent dedans, en coordonnées relatives. -->
            <Panel Width="{Binding Width}" Height="{Binding Height}"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="{Binding Rotation, Converter={x:Static conv:Conv.Rotate}}">
                <views:FondBloc Classes="frameFill"/>
                <!-- Les blocs sont découpés à la zone que le noyau calcule, la même qu'à
                     l'export (poste Q5), et non au cadre du groupe comme le ferait le
                     thème : un filet centré sur le bord du groupe y perdrait sa moitié. -->
                <ItemsControl Classes="frames" ItemsSource="{Binding Children}" ClipToBounds="False">
                    <ItemsControl.Clip>
                        <MultiBinding Converter="{x:Static conv:DecoupeDesBlocs.Instance}">
                            <Binding/>
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                        </MultiBinding>
                    </ItemsControl.Clip>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Rectangle Classes="frameStroke"/>
            </Panel>
        </DataTemplate>

        <DataTemplate DataType="models:TableFrame">
            <!-- Un tableau se rend comme un groupe : il pose son repère, et ses cases
                 s'y dessinent en coordonnées relatives. Ces cases sont des blocs de
                 texte calculés par le modèle, si bien qu'elles passent par le gabarit
                 ci-dessus — l'écran n'a aucun rendu de tableau qui lui soit propre, et
                 l'export non plus. -->
            <Panel Width="{Binding Width}" Height="{Binding Height}"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="{Binding Rotation, Converter={x:Static conv:Conv.Rotate}}">
                <views:FondBloc Classes="frameFill"/>
                <!-- Même découpe qu'un groupe, lue au même endroit. -->
                <ItemsControl Classes="frames" ItemsSource="{Binding CellFrames}" ClipToBounds="False">
                    <ItemsControl.Clip>
                        <MultiBinding Converter="{x:Static conv:DecoupeDesBlocs.Instance}">
                            <Binding/>
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                            <Binding Path="CellFrames"/>
                        </MultiBinding>
                    </ItemsControl.Clip>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Rectangle Classes="frameStroke"/>
            </Panel>
        </DataTemplate>

    </UserControl.DataTemplates>

    <ScrollViewer Name="Scroller"
                  Background="#FF3A3D42"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

        <!-- La planche est centrée tant qu'elle tient dans la fenêtre, sinon elle défile.
             Les règles bordent la page et défilent avec elle : c'est ce qui garantit
             qu'une graduation tombe exactement en face de la position qu'elle annonce,
             sans avoir à suivre le défilement à la main. -->
        <Panel Name="Stage" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto">

                <Border Grid.Row="0" Grid.Column="0" Background="#FFF3F4F6"
                        BorderBrush="#FFD9DDE3" BorderThickness="0,0,1,1"
                        IsVisible="{Binding ShowRulers}"/>

                <views:Ruler Grid.Row="0" Grid.Column="1" Name="TopRuler"
                             Orientation="Horizontal"
                             IsVisible="{Binding ShowRulers}"
                             PageLength="{Binding Document.PageWidth}"
                             Scale="{Binding RenderScale}"/>

                <views:Ruler Grid.Row="1" Grid.Column="0" Name="LeftRuler"
                             Orientation="Vertical"
                             IsVisible="{Binding ShowRulers}"
                             PageLength="{Binding Document.PageHeight}"
                             Scale="{Binding RenderScale}"/>

            <Border Grid.Row="1" Grid.Column="1" Background="White" BoxShadow="0 6 28 0 #70000000">

                <!-- Trois couches superposées et exactement alignées :
                     la page mise à l'échelle, la couche de poignées, la couche de saisie. -->
                <Panel Name="Surface">

                    <LayoutTransformControl Name="Scaler"
                                            LayoutTransform="{Binding RenderScale, Converter={x:Static conv:Conv.Scale}}">
                        <!-- À l'intérieur de cette mise à l'échelle, une unité = un point typographique.
                             Aucune conversion n'est donc nécessaire sur les liaisons ci-dessous. -->
                        <!-- La charte du document — jeu de couleurs et jeu de polices — posée
                             ici et héritée par tout ce que la page dessine : changer de jeu
                             recolore d'un coup les blocs qui y font référence (poste C5b). -->
                        <Panel Name="PageRoot"
                               views:JeuAffiche.Charte="{Binding Document.Charte}"
                               Width="{Binding Document.PageWidth}"
                               Height="{Binding Document.PageHeight}"
                               Background="White"
                               ClipToBounds="True">

                            <!-- Le fond de page, sous tout le reste et sur le blanc de la
                                 planche : il se dessine par le même contrôle que le fond
                                 d'un bloc, et l'export le pose de même en tête de page.
                                 Absent, la page reste blanche comme elle l'a toujours été. -->
                            <views:FondBloc Fond="{Binding Document.Background}"
                                            IsHitTestVisible="False"/>

                            <!-- Repères : zone de marges, colonnes, lignes, lignes de base.
                                 Ils ne sont dessinés que là — l'export ne les connaît pas,
                                 et c'est ce qui garantit qu'ils ne s'impriment jamais. -->
                            <Panel IsVisible="{Binding ShowGuides}" IsHitTestVisible="False">
                                <Canvas>
                                    <Rectangle Canvas.Left="{Binding Document.MarginLeft}"
                                               Canvas.Top="{Binding Document.MarginTop}"
                                               Width="{Binding Document.MarginBoxWidth}"
                                               Height="{Binding Document.MarginBoxHeight}"
                                               Stroke="#FF7FB2E5" StrokeThickness="0.4"
                                               StrokeDashArray="6,4"/>
                                </Canvas>

                                <ItemsControl Classes="verticalGuides" ItemsSource="{Binding Document.VerticalGridLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:GuideLine">
                                            <Rectangle Width="0.4"
                                                       Height="{Binding #Board.((vm:MainWindowViewModel)DataContext).Document.PageHeight}"
                                                       Fill="#FF7FB2E5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Classes="horizontalGuides" ItemsSource="{Binding Document.HorizontalGridLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:GuideLine">
                                            <!-- Une ligne de base se pose au dixième de point et
                                                 s'efface : il y en a des dizaines par page, elles
                                                 guident sans devoir se voir. -->
                                            <Rectangle Width="{Binding #Board.((vm:MainWindowViewModel)DataContext).Document.PageWidth}"
                                                       Height="{Binding IsBaseline, Converter={x:Static conv:Conv.GuideWeight}}"
                                                       Fill="{Binding IsBaseline, Converter={x:Static conv:Conv.GuideTint}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Repères libres, d'un vert franc : ce sont les seuls
                                     que l'utilisateur a posés lui-même, ils doivent se
                                     distinguer de la grille qu'il a réglée. -->
                                <ItemsControl Classes="verticalRulerGuides" ItemsSource="{Binding Document.VerticalRulerGuides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:RulerGuide">
                                            <Rectangle Width="0.5"
                                                       Height="{Binding #Board.((vm:MainWindowViewModel)DataContext).Document.PageHeight}"
                                                       Fill="#FF2F9E5E"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Classes="horizontalRulerGuides" ItemsSource="{Binding Document.HorizontalRulerGuides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:RulerGuide">
                                            <Rectangle Width="{Binding #Board.((vm:MainWindowViewModel)DataContext).Document.PageWidth}"
                                                       Height="0.5" Fill="#FF2F9E5E"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>

                            <!-- La classe « frames » vaut pour ce canevas comme pour celui
                                 d'un groupe : c'est elle que vise le style de position. -->
                            <ItemsControl Classes="frames" ItemsSource="{Binding CurrentPage.Frames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                        </Panel>
                    </LayoutTransformControl>

                    <!-- Hors de la mise à l'échelle : les poignées gardent une taille constante
                         quel que soit le zoom. Leurs positions sont calculées en code-behind. -->
                    <Canvas Name="Overlay" IsHitTestVisible="False"/>

                    <Border Name="InputLayer" Background="Transparent"/>
                </Panel>
            </Border>
            </Grid>
        </Panel>
    </ScrollViewer>
</UserControl>
