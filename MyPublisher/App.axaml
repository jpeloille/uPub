<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPublisher.App"
             xmlns:local="using:MyPublisher"
             RequestedThemeVariant="Light">
             <!-- Clair, et non « Default ». Toute la palette de l'application est écrite
                  en clair — panneaux, barres, planche, repères — et le fond de la page
                  est du papier, qui est blanc par nature. Suivre la variante du système
                  donnait, sur un bureau sombre, des listes et des champs sombres posés
                  au milieu de panneaux clairs, et un fond de fenêtre noir partout où
                  aucune couleur n'était écrite à la main. Servir vraiment le mode sombre
                  demanderait de reprendre la centaine de couleurs du chrome ; tant que
                  ce n'est pas fait, mieux vaut une application cohérente. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <!-- Le sélecteur de couleur vit dans un paquet séparé : son thème doit être inclus explicitement. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    </Application.Styles>
</Application>